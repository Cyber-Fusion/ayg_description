<mujoco model="ayg">
  <!--
    Ayg 1.3, kept in step with urdf/ayg.xacro + urdf/legs.xacro + urdf/lidar.xacro
    (SolidWorks export CF-AYG-1.3-00-000-URDF-6). Masses, CoMs, inertias, joint
    origins, limits and collision primitives are the same numbers as the URDF; see
    those files for the derivations.

    Two fixes carried in alongside the 1.3 numbers:
      * the previous revision declared a `Foot.STL` asset that has never existed in
        meshes/, so the model could not load. Feet are primitives here, as in the
        URDF, where the export's own foot inertia is exactly a solid cylinder
        r=0.032 L=0.031.
      * the head was a visual-only geom on Base whose 0.727 kg was therefore
        absent from the model. It is now a child body with its own inertial, so
        the total is the real 22.948 kg.

    Hind legs no longer carry the pi yaw the 1.2 model used. It only ever existed
    so front and hind could share a hip mesh; the export ships four, and dropping
    it changes no joint value (the thigh frame was Base-aligned either way).
  -->
  <compiler angle="radian" meshdir="../meshes"/>

  <option timestep="0.001" iterations="50" solver="Newton" gravity="0 0 -9.81"
          noslip_iterations="5"/>

  <default>
    <joint damping="0" armature="0"/>
    <geom friction="1.5 0.005 0.001" condim="6" contype="1" conaffinity="1" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <motor ctrllimited="true"/>
  </default>

  <asset>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.6 0.6 0.6"
             width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.2"/>

    <mesh name="Base" file="Base.STL"/>
    <mesh name="Head" file="Head.STL"/>
    <mesh name="LF_Hip" file="LF_Hip.STL"/>
    <mesh name="RF_Hip" file="RF_Hip.STL"/>
    <mesh name="LH_Hip" file="LH_Hip.STL"/>
    <mesh name="RH_Hip" file="RH_Hip.STL"/>
    <mesh name="L_Thigh" file="L_Thigh.STL"/>
    <mesh name="R_Thigh" file="R_Thigh.STL"/>
    <mesh name="Shank" file="Shank.STL"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" contype="1" conaffinity="1"
          friction="1.5 0.005 0.001" condim="6" solimp="0.9 0.95 0.001" solref="0.02 1"/>

    <!-- Spawn height clears the zero-joint pose: the 1.3 leg puts the feet 0.4225 m
         below Base at all-zero joints (was 0.341 m), so 0.40 would start the model
         underground. -->
    <body name="Base" pos="0 0 0.46">
      <freejoint name="float_base"/>
      <!-- Batteries are lumped into Base (rigidly fixed inside the chassis). -->
      <inertial pos="-0.00030633 -0.0051482 -0.0019103" mass="10.732"
                fullinertia="0.029884 0.038536 0.055747 4.1808e-07 0.00015159 1.5415e-07"/>
      <geom name="Base_visual" type="mesh" mesh="Base" rgba="0.69804 0.69804 0.69804 1"
            contype="0" conaffinity="0" group="1"/>
      <geom name="Base_collision" type="box" size="0.2115 0.1195 0.075" pos="-0.001 0 -0.013"
            rgba="0.69804 0.69804 0.69804 1" group="3"/>
      <site name="imu_site" pos="0 0 -0.00983" size="0.001" rgba="0 1 0 1"/>

      <!-- ==================== Head (LiDAR mount) ==================== -->
      <!-- 0.72713 kg INCLUDING the JT128 body; do not add sensor mass. Collision
           is three boxes (deck / pod / nose) because the mesh fills only 10.4% of
           its bounding box and this is the body that strikes obstacles. -->
      <body name="Head" pos="0.199 0 0.05">
        <inertial pos="0.14526 0.0015227 -0.038347" mass="0.72713"
                  fullinertia="0.00048304 0.0012008 0.001352 5.642e-09 2.7327e-05 4.3319e-09"/>
        <geom name="Head_visual" type="mesh" mesh="Head" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="Head_deck_collision" type="box" size="0.113 0.055 0.00625"
              pos="0.113 0 0.00175" group="3"/>
        <geom name="Head_pod_collision" type="box" size="0.0265 0.067 0.043"
              pos="0.1395 0 -0.049" group="3"/>
        <geom name="Head_nose_collision" type="box" size="0.026 0.032 0.032"
              pos="0.192 0 -0.061" group="3"/>
        <!-- JT128 point-cloud origin, matching urdf/lidar.xacro's resolved
             lidar_link: pos on the spin axis 0.15584 m from the Head origin,
             quat = URDF rpy (-1.965587, 0, -1.570796) = (2 -3 3 -2)/sqrt(26),
             site z = spin axis (forward, 22.62 deg down). MuJoCo has no
             gpu_lidar; a real scan needs rangefinder sensors off this site. -->
        <site name="lidar_site" pos="0.143852 0 -0.059938"
              quat="0.39223227 -0.58834841 0.58834841 -0.39223227"
              size="0.002" rgba="0 0 1 1"/>
      </body>

      <!-- ==================== Left Front Leg ==================== -->
      <body name="LF_Hip" pos="0.203 0.054 0">
        <inertial pos="0.059856 0.0023868 1.6688e-05" mass="0.98111"
                  fullinertia="0.00070791 0.0012845 0.00087996 1.6598e-06 9.3501e-07 -2.4177e-07"/>
        <joint name="LF_HAA" axis="1 0 0" range="-0.5236 0.43633"/>
        <geom name="LF_Hip_visual" type="mesh" mesh="LF_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="LF_Hip_collision" type="cylinder" size="0.053" fromto="0.056 -0.033 0  0.056 0.025 0" group="3"/>

        <body name="LF_Thigh" pos="0.063 0.0996 0">
          <inertial pos="-0.028374 -0.02602 -0.029622" mass="1.5051"
                    fullinertia="0.0043448 0.0075708 0.0039222 0.00034914 -0.0029698 0.00034106"/>
          <joint name="LF_HFE" axis="0 -1 0" range="-2.0412 3.3693"/>
          <geom name="LF_Thigh_visual" type="mesh" mesh="L_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="LF_Thigh_barrel" type="cylinder" size="0.055" fromto="0 -0.07605 0  0 0.01195 0" group="3"/>
          <geom name="LF_Thigh_collision" type="box" size="0.026 0.008 0.085"
                pos="-0.1121 -0.0035 -0.1091" quat="0.32593 0 -0.94539 0" group="3"/>

          <body name="LF_Shank" pos="-0.15715 -0.0035 -0.20082">
            <inertial pos="0.081442 -1.3138e-05 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="LF_KFE" axis="0 -1 0" range="-0.56374 1.4085"/>
            <geom name="LF_Shank_visual" type="mesh" mesh="Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="LF_Shank_collision" type="box" size="0.020 0.0085 0.090"
                  pos="0.0897 0 -0.0938" quat="0.35797 0 0.93373 0" group="3"/>
            <geom name="LF_Knee_collision" type="cylinder" size="0.030" fromto="0 -0.0095 0  0 0.0095 0" group="3"/>

            <body name="LF_Foot" pos="0.170476 0 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="LF_Foot_visual" type="cylinder" size="0.032 0.0155" quat="0.70711 0.70711 0 0"
                    rgba="0.29804 0.29804 0.29804 1" contype="0" conaffinity="0" group="1"/>
              <geom name="LF_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="LF_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== Right Front Leg ==================== -->
      <body name="RF_Hip" pos="0.203 -0.054 0">
        <inertial pos="0.059856 -0.0023868 -1.6688e-05" mass="0.98111"
                  fullinertia="0.00070791 0.0012845 0.00087996 -1.6598e-06 -9.3501e-07 -2.4177e-07"/>
        <joint name="RF_HAA" axis="1 0 0" range="-0.43633 0.5236"/>
        <geom name="RF_Hip_visual" type="mesh" mesh="RF_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="RF_Hip_collision" type="cylinder" size="0.053" fromto="0.056 -0.025 0  0.056 0.033 0" group="3"/>

        <body name="RF_Thigh" pos="0.063 -0.0996 0">
          <inertial pos="-0.02838 0.025988 -0.029631" mass="1.5052"
                    fullinertia="0.0043476 0.0075751 0.0039239 -0.00034935 -0.0029719 -0.00034134"/>
          <joint name="RF_HFE" axis="0 -1 0" range="-2.0412 3.3693"/>
          <geom name="RF_Thigh_visual" type="mesh" mesh="R_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="RF_Thigh_barrel" type="cylinder" size="0.055" fromto="0 -0.01195 0  0 0.07605 0" group="3"/>
          <geom name="RF_Thigh_collision" type="box" size="0.026 0.008 0.085"
                pos="-0.1121 0.0035 -0.1091" quat="0.32593 0 -0.94539 0" group="3"/>

          <body name="RF_Shank" pos="-0.15715 0.0035 -0.20082">
            <inertial pos="0.081442 -1.3138e-05 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="RF_KFE" axis="0 -1 0" range="-0.56374 1.4085"/>
            <geom name="RF_Shank_visual" type="mesh" mesh="Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="RF_Shank_collision" type="box" size="0.020 0.0085 0.090"
                  pos="0.0897 0 -0.0938" quat="0.35797 0 0.93373 0" group="3"/>
            <geom name="RF_Knee_collision" type="cylinder" size="0.030" fromto="0 -0.0095 0  0 0.0095 0" group="3"/>

            <body name="RF_Foot" pos="0.170476 0 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="RF_Foot_visual" type="cylinder" size="0.032 0.0155" quat="0.70711 0.70711 0 0"
                    rgba="0.29804 0.29804 0.29804 1" contype="0" conaffinity="0" group="1"/>
              <geom name="RF_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="RF_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== Left Hind Leg ==================== -->
      <body name="LH_Hip" pos="-0.203 0.054 0">
        <inertial pos="-0.059856 0.0023868 -1.6688e-05" mass="0.98111"
                  fullinertia="0.00070791 0.0012845 0.00087996 -1.6598e-06 9.3501e-07 2.4177e-07"/>
        <joint name="LH_HAA" axis="1 0 0" range="-0.5236 0.8203"/>
        <geom name="LH_Hip_visual" type="mesh" mesh="LH_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="LH_Hip_collision" type="cylinder" size="0.053" fromto="-0.056 -0.033 0  -0.056 0.025 0" group="3"/>

        <body name="LH_Thigh" pos="-0.063 0.0996 0">
          <inertial pos="-0.028374 -0.02602 -0.029622" mass="1.5051"
                    fullinertia="0.0043448 0.0075708 0.0039222 0.00034914 -0.0029698 0.00034106"/>
          <joint name="LH_HFE" axis="0 -1 0" range="-2.8266 2.5839"/>
          <geom name="LH_Thigh_visual" type="mesh" mesh="L_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="LH_Thigh_barrel" type="cylinder" size="0.055" fromto="0 -0.07605 0  0 0.01195 0" group="3"/>
          <geom name="LH_Thigh_collision" type="box" size="0.026 0.008 0.085"
                pos="-0.1121 -0.0035 -0.1091" quat="0.32593 0 -0.94539 0" group="3"/>

          <body name="LH_Shank" pos="-0.15715 -0.0035 -0.20082">
            <inertial pos="0.081442 -1.3138e-05 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="LH_KFE" axis="0 -1 0" range="-0.56374 1.4085"/>
            <geom name="LH_Shank_visual" type="mesh" mesh="Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="LH_Shank_collision" type="box" size="0.020 0.0085 0.090"
                  pos="0.0897 0 -0.0938" quat="0.35797 0 0.93373 0" group="3"/>
            <geom name="LH_Knee_collision" type="cylinder" size="0.030" fromto="0 -0.0095 0  0 0.0095 0" group="3"/>

            <body name="LH_Foot" pos="0.170476 0 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="LH_Foot_visual" type="cylinder" size="0.032 0.0155" quat="0.70711 0.70711 0 0"
                    rgba="0.29804 0.29804 0.29804 1" contype="0" conaffinity="0" group="1"/>
              <geom name="LH_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="LH_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== Right Hind Leg ==================== -->
      <body name="RH_Hip" pos="-0.203 -0.054 0">
        <inertial pos="-0.059856 -0.0023868 1.6688e-05" mass="0.98111"
                  fullinertia="0.00070791 0.0012845 0.00087996 1.6598e-06 -9.3501e-07 2.4177e-07"/>
        <joint name="RH_HAA" axis="1 0 0" range="-0.8203 0.5236"/>
        <geom name="RH_Hip_visual" type="mesh" mesh="RH_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="RH_Hip_collision" type="cylinder" size="0.053" fromto="-0.056 -0.025 0  -0.056 0.033 0" group="3"/>

        <body name="RH_Thigh" pos="-0.063 -0.0996 0">
          <inertial pos="-0.02838 0.025988 -0.029631" mass="1.5052"
                    fullinertia="0.0043476 0.0075751 0.0039239 -0.00034935 -0.0029719 -0.00034134"/>
          <joint name="RH_HFE" axis="0 -1 0" range="-2.8266 2.5839"/>
          <geom name="RH_Thigh_visual" type="mesh" mesh="R_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="RH_Thigh_barrel" type="cylinder" size="0.055" fromto="0 -0.01195 0  0 0.07605 0" group="3"/>
          <geom name="RH_Thigh_collision" type="box" size="0.026 0.008 0.085"
                pos="-0.1121 0.0035 -0.1091" quat="0.32593 0 -0.94539 0" group="3"/>

          <body name="RH_Shank" pos="-0.15715 0.0035 -0.20082">
            <inertial pos="0.081442 -1.3138e-05 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="RH_KFE" axis="0 -1 0" range="-0.56374 1.4085"/>
            <geom name="RH_Shank_visual" type="mesh" mesh="Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="RH_Shank_collision" type="box" size="0.020 0.0085 0.090"
                  pos="0.0897 0 -0.0938" quat="0.35797 0 0.93373 0" group="3"/>
            <geom name="RH_Knee_collision" type="cylinder" size="0.030" fromto="0 -0.0095 0  0 0.0095 0" group="3"/>

            <body name="RH_Foot" pos="0.170476 0 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="RH_Foot_visual" type="cylinder" size="0.032 0.0155" quat="0.70711 0.70711 0 0"
                    rgba="0.29804 0.29804 0.29804 1" contype="0" conaffinity="0" group="1"/>
              <geom name="RH_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="RH_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Left Front -->
    <motor name="LF_HAA_motor" joint="LF_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="LF_HFE_motor" joint="LF_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="LF_KFE_motor" joint="LF_KFE" ctrlrange="-50 50" gear="1"/>
    <!-- Right Front -->
    <motor name="RF_HAA_motor" joint="RF_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="RF_HFE_motor" joint="RF_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="RF_KFE_motor" joint="RF_KFE" ctrlrange="-50 50" gear="1"/>
    <!-- Left Hind -->
    <motor name="LH_HAA_motor" joint="LH_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="LH_HFE_motor" joint="LH_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="LH_KFE_motor" joint="LH_KFE" ctrlrange="-50 50" gear="1"/>
    <!-- Right Hind -->
    <motor name="RH_HAA_motor" joint="RH_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="RH_HFE_motor" joint="RH_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="RH_KFE_motor" joint="RH_KFE" ctrlrange="-50 50" gear="1"/>
  </actuator>

  <sensor>
    <!-- IMU sensors on Base -->
    <accelerometer name="imu_acc" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>

    <!-- Foot contact sensors -->
    <touch name="LF_Foot_touch" site="LF_Foot_contact"/>
    <touch name="RF_Foot_touch" site="RF_Foot_contact"/>
    <touch name="LH_Foot_touch" site="LH_Foot_contact"/>
    <touch name="RH_Foot_touch" site="RH_Foot_contact"/>

    <!-- Joint position/velocity sensors -->
    <jointpos name="LF_HAA_pos" joint="LF_HAA"/>
    <jointpos name="LF_HFE_pos" joint="LF_HFE"/>
    <jointpos name="LF_KFE_pos" joint="LF_KFE"/>
    <jointpos name="RF_HAA_pos" joint="RF_HAA"/>
    <jointpos name="RF_HFE_pos" joint="RF_HFE"/>
    <jointpos name="RF_KFE_pos" joint="RF_KFE"/>
    <jointpos name="LH_HAA_pos" joint="LH_HAA"/>
    <jointpos name="LH_HFE_pos" joint="LH_HFE"/>
    <jointpos name="LH_KFE_pos" joint="LH_KFE"/>
    <jointpos name="RH_HAA_pos" joint="RH_HAA"/>
    <jointpos name="RH_HFE_pos" joint="RH_HFE"/>
    <jointpos name="RH_KFE_pos" joint="RH_KFE"/>

    <jointvel name="LF_HAA_vel" joint="LF_HAA"/>
    <jointvel name="LF_HFE_vel" joint="LF_HFE"/>
    <jointvel name="LF_KFE_vel" joint="LF_KFE"/>
    <jointvel name="RF_HAA_vel" joint="RF_HAA"/>
    <jointvel name="RF_HFE_vel" joint="RF_HFE"/>
    <jointvel name="RF_KFE_vel" joint="RF_KFE"/>
    <jointvel name="LH_HAA_vel" joint="LH_HAA"/>
    <jointvel name="LH_HFE_vel" joint="LH_HFE"/>
    <jointvel name="LH_KFE_vel" joint="LH_KFE"/>
    <jointvel name="RH_HAA_vel" joint="RH_HAA"/>
    <jointvel name="RH_HFE_vel" joint="RH_HFE"/>
    <jointvel name="RH_KFE_vel" joint="RH_KFE"/>
  </sensor>
</mujoco>
