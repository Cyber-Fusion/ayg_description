<mujoco model="ayg">
  <compiler angle="radian" meshdir="../meshes"/>

  <option timestep="0.001" iterations="50" solver="Newton" gravity="0 0 -9.81"
          noslip_iterations="5"/>

  <default>
    <joint damping="0" armature="0"/>
    <geom friction="1.5 0.005 0.001" condim="6" contype="1" conaffinity="1" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <motor ctrllimited="true"/>
  </default>

  <asset>
    <texture type="2d" name="grid" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.6 0.6 0.6"
             width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="8 8" reflectance="0.2"/>

    <mesh name="Base" file="Base.STL"/>
    <mesh name="L_Hip" file="L_Hip.STL"/>
    <mesh name="R_Hip" file="R_Hip.STL"/>
    <mesh name="L_Thigh" file="L_Thigh.STL"/>
    <mesh name="R_Thigh" file="R_Thigh.STL"/>
    <mesh name="L_Shank" file="L_Shank.STL"/>
    <mesh name="R_Shank" file="R_Shank.STL"/>
    <mesh name="Head" file="Head.STL"/>
    <mesh name="Foot" file="Foot.STL"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3"/>
    <geom name="floor" type="plane" size="5 5 0.1" material="grid_mat" contype="1" conaffinity="1"
          friction="1.5 0.005 0.001" condim="6" solimp="0.9 0.95 0.001" solref="0.02 1"/>

    <body name="Base" pos="0 0 0.40">
      <freejoint name="float_base"/>
      <!-- Ayg 1.3: batteries lumped into Base mass/inertia (rigidly fixed). Total ~23 kg. -->
      <inertial pos="-0.0030682 -4.5608e-05 -0.0023186" mass="11.049"
                fullinertia="0.032662 0.034773 0.054917 -2.5713e-06 6.2419e-05 -2.217e-06"/>
      <geom name="Base_visual" type="mesh" mesh="Base" rgba="0.69804 0.69804 0.69804 1"
            contype="0" conaffinity="0" group="1"/>
      <geom name="Base_collision" type="box" size="0.21 0.115 0.07" rgba="0.69804 0.69804 0.69804 1"
            group="3"/>
      <site name="imu_site" pos="0 0 -0.00983" size="0.001" rgba="0 1 0 1"/>

      <!-- Front head housing (fixed to Base). Head mesh is base-aligned (identity). -->
      <geom name="Camera_visual" type="mesh" mesh="Head" pos="0.257 0 0.095"
            rgba="0.69804 0.69804 0.69804 1" contype="0" conaffinity="0" group="1"/>
      <!-- Forward-looking color camera at the head/D555 mount.
           xyaxes maps MuJoCo camera (-z fwd) to Base (+x fwd, +z up).
           fovy=65 matches D555 RGB vertical FoV. -->
      <camera name="Camera_color" pos="0.257 0 0.095" xyaxes="0 -1 0 0 0 1" fovy="65"/>

      <!-- ==================== Left Front Leg ==================== -->
      <body name="LF_Hip" pos="0.2105 0.054 0">
        <inertial pos="0.062976 -0.0014435 9.395e-06" mass="1.017"
                  fullinertia="0.00088413 0.0014074 0.00099675 1.6599e-05 5.521e-07 -1.7604e-07"/>
        <joint name="LF_HAA" axis="1 0 0" range="-0.5236 0.43633"/>
        <geom name="LF_Hip_visual" type="mesh" mesh="L_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="LF_Hip_collision" type="box" size="0.055 0.035 0.055" pos="0.055 0 0" group="3"/>

        <body name="LF_Thigh" pos="0.065 0.0235 0">
          <inertial pos="-0.023305 0.049402 -0.024328" mass="1.505"
                    fullinertia="0.0030493 0.0052191 0.0026578 -3.2033e-06 -0.0016346 -1.6215e-06"/>
          <joint name="LF_HFE" axis="0 -1 0" range="-1.2625 3.0761"/>
          <geom name="LF_Thigh_visual" type="mesh" mesh="L_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="LF_Thigh_collision" type="box" size="0.03 0.03 0.12"
                pos="-0.0786 0.0285 -0.1004" quat="0.058907 -0.926158 0.162842 0.33503" group="3"/>

          <body name="LF_Shank" pos="-0.15715 0.057018 -0.20082">
            <inertial pos="0.081442 0.015569 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="LF_KFE" axis="0 -1 0" range="-0.56374 1.4015"/>
            <geom name="LF_Shank_visual" type="mesh" mesh="L_Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="LF_Shank_collision" type="box" size="0.025 0.025 0.12"
                  pos="0.0852 0.0078 -0.0948" quat="0.358581 -0.0425 0.932387 0.016345" group="3"/>

            <body name="LF_Foot" pos="0.17048 0.015582 -0.18964">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="LF_Foot_visual" type="mesh" mesh="Foot" rgba="0.29804 0.29804 0.29804 1"
                    contype="0" conaffinity="0" group="1"/>
              <geom name="LF_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="LF_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== Right Front Leg ==================== -->
      <body name="RF_Hip" pos="0.2105 -0.054 0">
        <inertial pos="0.062976 0.0014435 -9.395e-06" mass="1.017"
                  fullinertia="0.00088413 0.0014074 0.00099675 -1.6599e-05 -5.521e-07 -1.7604e-07"/>
        <joint name="RF_HAA" axis="1 0 0" range="-0.43633 0.5236"/>
        <geom name="RF_Hip_visual" type="mesh" mesh="R_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="RF_Hip_collision" type="box" size="0.055 0.035 0.055" pos="0.055 0 0" group="3"/>

        <body name="RF_Thigh" pos="0.065 -0.0235 0">
          <inertial pos="-0.02331 -0.049428 -0.024336" mass="1.5051"
                    fullinertia="0.0030504 0.0052207 0.0026583 3.2136e-06 -0.0016352 1.6374e-06"/>
          <joint name="RF_HFE" axis="0 -1 0" range="-1.2625 3.0761"/>
          <geom name="RF_Thigh_visual" type="mesh" mesh="R_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="RF_Thigh_collision" type="box" size="0.03 0.03 0.12"
                pos="-0.0786 -0.0285 -0.1004" quat="0.058907 0.926158 0.162842 -0.33503" group="3"/>

          <body name="RF_Shank" pos="-0.15715 -0.057037 -0.20082">
            <inertial pos="0.081442 -0.015577 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="RF_KFE" axis="0 -1 0" range="-0.56374 1.4015"/>
            <geom name="RF_Shank_visual" type="mesh" mesh="R_Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="RF_Shank_collision" type="box" size="0.025 0.025 0.12"
                  pos="0.0852 -0.0078 -0.0948" quat="0.358581 0.0425 0.932387 -0.016345" group="3"/>

            <body name="RF_Foot" pos="0.170476 -0.0155635 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="RF_Foot_visual" type="mesh" mesh="Foot" rgba="0.29804 0.29804 0.29804 1"
                    contype="0" conaffinity="0" group="1"/>
              <geom name="RF_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="RF_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== Left Hind Leg (pi yaw: quat 0 0 0 1) ==================== -->
      <body name="LH_Hip" pos="-0.2105 0.054 0" quat="0 0 0 1">
        <inertial pos="0.062976 0.0014435 -9.395e-06" mass="1.017"
                  fullinertia="0.00088413 0.0014074 0.00099675 -1.6599e-05 -5.521e-07 -1.7604e-07"/>
        <joint name="LH_HAA" axis="-1 0 0" range="-0.5236 0.8203"/>
        <geom name="LH_Hip_visual" type="mesh" mesh="R_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="LH_Hip_collision" type="box" size="0.055 0.035 0.055" pos="0.055 0 0" group="3"/>

        <body name="LH_Thigh" pos="0.065 -0.0235 0" quat="0 0 0 1">
          <inertial pos="-0.023305 0.049402 -0.024328" mass="1.505"
                    fullinertia="0.0030493 0.0052191 0.0026578 -3.2033e-06 -0.0016346 -1.6215e-06"/>
          <joint name="LH_HFE" axis="0 -1 0" range="-2.2907 2.0479"/>
          <geom name="LH_Thigh_visual" type="mesh" mesh="L_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="LH_Thigh_collision" type="box" size="0.03 0.03 0.12"
                pos="-0.0786 0.0285 -0.1004" quat="0.058907 -0.926158 0.162842 0.33503" group="3"/>

          <body name="LH_Shank" pos="-0.15715 0.057018 -0.20082">
            <inertial pos="0.081442 0.015569 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="LH_KFE" axis="0 -1 0" range="-0.56374 1.4015"/>
            <geom name="LH_Shank_visual" type="mesh" mesh="L_Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="LH_Shank_collision" type="box" size="0.025 0.025 0.12"
                  pos="0.0852 0.0078 -0.0948" quat="0.358581 -0.0425 0.932387 0.016345" group="3"/>

            <body name="LH_Foot" pos="0.170476 0.0155823 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="LH_Foot_visual" type="mesh" mesh="Foot" rgba="0.29804 0.29804 0.29804 1"
                    contype="0" conaffinity="0" group="1"/>
              <geom name="LH_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="LH_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== Right Hind Leg (pi yaw: quat 0 0 0 1) ==================== -->
      <body name="RH_Hip" pos="-0.2105 -0.054 0" quat="0 0 0 1">
        <inertial pos="0.062976 -0.0014435 9.395e-06" mass="1.017"
                  fullinertia="0.00088413 0.0014074 0.00099675 1.6599e-05 5.521e-07 -1.7604e-07"/>
        <joint name="RH_HAA" axis="-1 0 0" range="-0.8203 0.5236"/>
        <geom name="RH_Hip_visual" type="mesh" mesh="L_Hip" rgba="0.69804 0.69804 0.69804 1"
              contype="0" conaffinity="0" group="1"/>
        <geom name="RH_Hip_collision" type="box" size="0.055 0.035 0.055" pos="0.055 0 0" group="3"/>

        <body name="RH_Thigh" pos="0.065 0.0235 0" quat="0 0 0 1">
          <inertial pos="-0.02331 -0.049428 -0.024336" mass="1.5051"
                    fullinertia="0.0030504 0.0052207 0.0026583 3.2136e-06 -0.0016352 1.6374e-06"/>
          <joint name="RH_HFE" axis="0 -1 0" range="-2.2907 2.0479"/>
          <geom name="RH_Thigh_visual" type="mesh" mesh="R_Thigh" rgba="0.69804 0.69804 0.69804 1"
                contype="0" conaffinity="0" group="1"/>
          <geom name="RH_Thigh_collision" type="box" size="0.03 0.03 0.12"
                pos="-0.0786 -0.0285 -0.1004" quat="0.058907 0.926158 0.162842 -0.33503" group="3"/>

          <body name="RH_Shank" pos="-0.15715 -0.057037 -0.20082">
            <inertial pos="0.081442 -0.015577 -0.079562" mass="0.34563"
                      fullinertia="0.0016882 0.0032906 0.0016244 -5.8149e-12 0.0015751 -3.2788e-12"/>
            <joint name="RH_KFE" axis="0 -1 0" range="-0.56374 1.4015"/>
            <geom name="RH_Shank_visual" type="mesh" mesh="R_Shank" rgba="0.69804 0.69804 0.69804 1"
                  contype="0" conaffinity="0" group="1"/>
            <geom name="RH_Shank_collision" type="box" size="0.025 0.025 0.12"
                  pos="0.0852 -0.0078 -0.0948" quat="0.358581 0.0425 0.932387 -0.016345" group="3"/>

            <body name="RH_Foot" pos="0.170476 -0.0155635 -0.189639">
              <inertial pos="0 0 0" mass="0.04"
                        fullinertia="1.3443e-05 2.048e-05 1.3443e-05 0 0 0"/>
              <geom name="RH_Foot_visual" type="mesh" mesh="Foot" rgba="0.29804 0.29804 0.29804 1"
                    contype="0" conaffinity="0" group="1"/>
              <geom name="RH_Foot_collision" type="sphere" size="0.032" friction="2.0 0.01 0.001" group="3"/>
              <site name="RH_Foot_contact" pos="0 0 0" size="0.001" rgba="1 0 0 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Left Front -->
    <motor name="LF_HAA_motor" joint="LF_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="LF_HFE_motor" joint="LF_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="LF_KFE_motor" joint="LF_KFE" ctrlrange="-50 50" gear="1"/>
    <!-- Right Front -->
    <motor name="RF_HAA_motor" joint="RF_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="RF_HFE_motor" joint="RF_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="RF_KFE_motor" joint="RF_KFE" ctrlrange="-50 50" gear="1"/>
    <!-- Left Hind -->
    <motor name="LH_HAA_motor" joint="LH_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="LH_HFE_motor" joint="LH_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="LH_KFE_motor" joint="LH_KFE" ctrlrange="-50 50" gear="1"/>
    <!-- Right Hind -->
    <motor name="RH_HAA_motor" joint="RH_HAA" ctrlrange="-50 50" gear="1"/>
    <motor name="RH_HFE_motor" joint="RH_HFE" ctrlrange="-50 50" gear="1"/>
    <motor name="RH_KFE_motor" joint="RH_KFE" ctrlrange="-50 50" gear="1"/>
  </actuator>

  <sensor>
    <!-- IMU sensors on Base -->
    <accelerometer name="imu_acc" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>

    <!-- Foot contact sensors -->
    <touch name="LF_Foot_touch" site="LF_Foot_contact"/>
    <touch name="RF_Foot_touch" site="RF_Foot_contact"/>
    <touch name="LH_Foot_touch" site="LH_Foot_contact"/>
    <touch name="RH_Foot_touch" site="RH_Foot_contact"/>

    <!-- Joint position/velocity sensors -->
    <jointpos name="LF_HAA_pos" joint="LF_HAA"/>
    <jointpos name="LF_HFE_pos" joint="LF_HFE"/>
    <jointpos name="LF_KFE_pos" joint="LF_KFE"/>
    <jointpos name="RF_HAA_pos" joint="RF_HAA"/>
    <jointpos name="RF_HFE_pos" joint="RF_HFE"/>
    <jointpos name="RF_KFE_pos" joint="RF_KFE"/>
    <jointpos name="LH_HAA_pos" joint="LH_HAA"/>
    <jointpos name="LH_HFE_pos" joint="LH_HFE"/>
    <jointpos name="LH_KFE_pos" joint="LH_KFE"/>
    <jointpos name="RH_HAA_pos" joint="RH_HAA"/>
    <jointpos name="RH_HFE_pos" joint="RH_HFE"/>
    <jointpos name="RH_KFE_pos" joint="RH_KFE"/>

    <jointvel name="LF_HAA_vel" joint="LF_HAA"/>
    <jointvel name="LF_HFE_vel" joint="LF_HFE"/>
    <jointvel name="LF_KFE_vel" joint="LF_KFE"/>
    <jointvel name="RF_HAA_vel" joint="RF_HAA"/>
    <jointvel name="RF_HFE_vel" joint="RF_HFE"/>
    <jointvel name="RF_KFE_vel" joint="RF_KFE"/>
    <jointvel name="LH_HAA_vel" joint="LH_HAA"/>
    <jointvel name="LH_HFE_vel" joint="LH_HFE"/>
    <jointvel name="LH_KFE_vel" joint="LH_KFE"/>
    <jointvel name="RH_HAA_vel" joint="RH_HAA"/>
    <jointvel name="RH_HFE_vel" joint="RH_HFE"/>
    <jointvel name="RH_KFE_vel" joint="RH_KFE"/>
  </sensor>
</mujoco>
