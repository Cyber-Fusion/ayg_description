         1.3443E-05), so the primitive is the mass model, not an approximation. -->
  <link name="RF_Foot">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.04"/>
      <inertia ixx="1.3443E-05" ixy="0" ixz="0" iyy="2.048E-05" iyz="0" izz="1.3443E-05"/>
