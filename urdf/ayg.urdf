      <origin rpy="0 0 0" xyz="-0.02838 0.025988 -0.029631"/>
      <mass value="1.5052"/>
      <inertia ixx="0.0043476" ixy="-0.00034935" ixz="-0.0029719" iyy="0.0075751" iyz="-0.00034134" izz="0.0039239"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ayg_description/meshes/R_Thigh.STL"/>
