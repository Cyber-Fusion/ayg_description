      <mass value="0.0013495"/>
      <inertia ixx="4.0133E-08" ixy="-6.9859E-14" ixz="8.9554E-12" iyy="5.9906E-08" iyz="-1.4567E-14" izz="9.917E-08"/>
    </inertial>
  </link>
  <joint name="Base_2_IMU" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.00983"/>
    <parent link="Base"/>
    <child link="IMU"/>
    <axis xyz="0 0 0"/>
