  <link name="Base">
    <inertial>
      <!-- Ayg 1.3 SolidWorks export. Batteries are rigidly fixed inside the
           chassis and are lumped into this Base mass/inertia (no separate
           Battery links), so the trunk is a single rigid body. Total robot
           mass ~23 kg. -->
