  <!--
    Physical front head body (Ayg 1.3 "Head" mesh + inertials from the SolidWorks
    export). The link keeps the name "Camera" so the D555 optical-frame tree,
    Gazebo sensors, realsense2_camera camera_name and all /camera/Camera/* topics
    are unchanged. The Head mesh is exported base-aligned; because Base_2_Camera
    carries a +90 deg roll (needed by the optical frames below), the visual and
    inertial are expressed with a compensating -90 deg roll so the head renders
    upright. Mass/CoM/inertia are the export Head values rolled into this frame.
  -->
  <link name="Camera">
    <inertial>
      <origin rpy="0 0 0" xyz="0.026077 -0.0052539 0"/>
      <mass value="0.38664"/>
      <inertia ixx="0.00083292" ixy="3.6679E-06" ixz="-5.259E-09" iyy="0.00084639" iyz="-2.8688E-09" izz="0.00011429"/>
    </inertial>
    <visual>
      <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ayg_description/meshes/Head.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.69804 0.69804 0.69804 1"/>
      </material>
    </visual>
    <!--
      Collision simplified to a primitive box wrapping the 1.3 Head mesh
      (extent 0.0942 x 0.053 x 0.1669 m in this link frame, centered at
      0.0121 -0.0062 0). A box is far cheaper for the physics broadphase than
      the full head mesh, and is what cf_lab's camera-contact termination
      (body_names="Camera") detects.
    -->
    <collision>
      <origin rpy="0 0 0" xyz="0.0121 -0.0062 0"/>
      <geometry>
        <box size="0.0942 0.053 0.1669"/>
      </geometry>
    </collision>
  </link>
  <!-- Ayg 1.3 head mount (export Base_2_Head at 0.257 0 0.095). rpy = +90 deg roll
       (for the optical-frame subtree below) + 15 deg pitch-down = the physical D555
       bracket, so the depth/color frames look 15 deg below horizontal. This is the
       single source of truth for the tilt: Gazebo, Isaac, RViz TF and the real
       robot all agree (the cf_lab depth-camera prim offset is identity). z=0.095 is
       the CAD-confirmed camera height. -->
  <joint name="Base_2_Camera" type="fixed">
    <origin rpy="1.5708 0.2618 0" xyz="0.257 0 0.095"/>
    <parent link="Base"/>
    <child link="Camera"/>
    <axis xyz="0 0 0"/>
  </joint>
  <link name="Camera_depth_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="Camera_depth_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 0" xyz="0.0527 -0.024 0"/>
    <parent link="Camera"/>
    <child link="Camera_depth_frame"/>
  </joint>
  <link name="Camera_depth_optical_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="Camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_depth_optical_frame"/>
  </joint>
  <link name="Camera_color_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="Camera_color_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 -0.0475 0"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_color_frame"/>
  </joint>
  <link name="Camera_color_optical_frame">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1e-6"/>
      <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
    </inertial>
  </link>
  <joint name="Camera_color_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="Camera_color_frame"/>
    <child link="Camera_color_optical_frame"/>
  </joint>
</robot>
