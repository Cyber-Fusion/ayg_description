    </collision>
    <!-- Knee filler: cylinder coaxial with the KFE axis, so it is invariant
           under knee bend and bridges the thigh/shank gap for external contacts
           without ever self-colliding with either. Length follows the new knee
           width (0.018 measured) rather than the old 0.031. -->
    <collision>
      <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.019" radius="0.030"/>
      </geometry>
    </collision>
  </link>
  <joint name="RF_KFE" type="revolute">
    <origin rpy="0 0 0" xyz="-0.15715 0.0035 -0.20082"/>
    <parent link="RF_Thigh"/>
    <child link="RF_Shank"/>
    <axis xyz="0 -1 0"/>
    <!-- Export (-1.4085, 0.56374) negated and swapped for the -y axis. -->
    <limit effort="50.0" lower="-0.56374" upper="1.4085" velocity="10.0"/>
  </joint>
  <!-- ============================== Foot ============================= -->
  <!-- Modelled as primitives rather than the export's Foot mesh: the export's
         own inertia is exactly that of a solid cylinder r=0.032, L=0.031 about y
