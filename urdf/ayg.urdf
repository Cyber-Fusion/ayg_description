  <!--
    Legs, Ayg 1.3 (SolidWorks export CF-AYG-1.3-00-000-URDF-6).

    One macro instantiated four times. `sx` = +1 front / -1 hind, `sy` = +1 left /
    -1 right; every joint origin and mirrored inertia term is written as an export
    value times those signs, so the file reads as a direct transcription of the
    export and can be re-checked against a future one line by line.

    Frames are the export's own placement, unchanged. Axes are normalized to the
    deployed convention: HAA about +x, HFE/KFE about -y (the export uses +y for
    HFE/KFE, so those two joints carry a negated axis and correspondingly
    negated-and-swapped limits). Because the HFE/KFE axes are parallel to y, the
    export's frame origins sit at an arbitrary point along the rotation axis -
    sliding them in y is kinematically null, which is why the export's y offsets
    differ from earlier revisions while the foot positions are identical.

    Segment lengths: thigh |(-0.15715, -0.20082)| = shank |(0.170476, -0.189639)|
    = 0.255 m exactly, so the leg extends 0.510 m hip-to-foot (was 0.443 m).
  -->
  <!-- ============================== Hip ============================== -->
  <!-- Four distinct hip meshes: front/hind are x-mirrored and left/right are
         Rx(pi) of each other, and the export tessellates each separately, so no
         single pair can be reused by rotating a joint frame. -->
  <link name="LF_Hip">
    <inertial>
      <origin rpy="0 0 0" xyz="0.059856 0.0023868 1.6688e-05"/>
      <mass value="0.98111"/>
      <inertia ixx="0.00070791" ixy="1.6598e-06" ixz="9.3501e-07" iyy="0.0012845" iyz="-2.4177e-07" izz="0.00087996"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://ayg_description/meshes/LF_Hip.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.69804 0.69804 0.69804 1"/>
      </material>
    </visual>
    <!-- Hip housing AND HFE motor barrel: ONE cylinder about y, spanning the
           whole HAA-to-HFE assembly (hip mesh y -0.0331..0.0250, barrel y
           0.0235..0.1116 -> 0.0393 +/- 0.0725). This is the pre-1.3 arrangement:
           the barrel is coaxial with the HFE axis, so carrying it on the parent
           link is kinematically identical to carrying it on the thigh, and it
           keeps one collider per hip instead of two.
           The housing mesh is symmetric in z (+/-0.0513) but its two sides are
           not: the top is roofed by the Head deck collider (underside z=+0.0455)
           and can never touch anything, while the underside faces terrain and is
           in the base_contact termination list. So the cylinder is r=0.047 with
           its axis dropped to z=-0.0045 rather than r=0.053 centred: bottom
           -0.0515 still covers the real underside (-0.0513), top +0.0425 clears
           the deck by 3 mm. A symmetric shrink to r=0.044 would clear the deck
           too but leave the exposed underside 7.3 mm short.
           The last few mm of each x end stay uncovered, which is where the HAA
           flange and the HFE interface sit - both shielded by the neighbouring
           link.
           x=0.058 rather than the mesh centre 0.0591 or the HFE axis 0.063: the
           Base box is not centred (front face +0.2105, rear face -0.2125), so
           0.058 is the smallest offset that clears the box at BOTH ends (front
           3.5 mm, hind 1.5 mm) while still stopping short of the Head pod
           collider at x=0.312 (4.0 mm). The Base overlap it removes is filtered
           anyway (parent-child); this only keeps the wrappers visually honest. -->
    <collision>
