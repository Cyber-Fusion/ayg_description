<?xml version="1.0" encoding="utf-8"?>
<robot name="ayg" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="False" />
  <xacro:property name="sim" default="$(arg sim)" />

  <xacro:arg name="sim_backend" default="gazebo" />
  <xacro:property name="sim_backend" value="$(arg sim_backend)" />

  <!-- The LiDAR's sensor frame (lidar_link) on the front head; the head itself
       is always present. -->
  <xacro:arg name="lidar" default="True" />
  <xacro:property name="lidar" default="$(arg lidar)" />

  <!-- Payload carried on Base, in kg. 0 is the bare robot; set it in
       simulation to test a policy under load. -->
  <xacro:arg name="payload_mass" default="0.0" />

  <xacro:arg name="initial_configuration" default="lying_down" />
  <xacro:property name="initial_configuration" value="$(arg initial_configuration)" />
  <xacro:arg name="controller" default="default" />
  <xacro:property name="controller" default="$(arg controller)" />

  <xacro:arg name="use_csp" default="false" />

  <!-- Robstride MIT gains the hardware interface applies until a controller
       claims the kp/kd command interfaces (none of the shipped ones does, so in
       practice these ARE the gains). kp=0 leaves the motors enabled but
       torque-free, which is how the joints are moved by hand for calibration:
       robstride_hardware/launch/quadruped.launch.py free_joints:=true. -->
  <xacro:arg name="default_kp" default="40.0" />
  <xacro:arg name="default_kd" default="1.0" />

  <xacro:property name="effort_lim" value="50.0" />
  <xacro:property name="velocity_lim" value="10.0" />
  <xacro:property name="PI" value="3.1415926535897931" />

  <xacro:if value="${sim}">
    <xacro:include filename="$(find ayg_description)/urdf/sim_ros2_control.xacro" />
  </xacro:if>

  <xacro:unless value="${sim}">
    <xacro:include filename="$(find robstride_hardware)/urdf/robstride_ros2_control.xacro"/>
    <xacro:robstride_ros2_control
      lf_can_interface="can0"
      rf_can_interface="can1"
      lh_can_interface="can2"
      rh_can_interface="can3"
      actuator_type="3"
      default_kp="$(arg default_kp)"
      default_kd="$(arg default_kd)"
      use_csp="$(arg use_csp)"
      calibration_file="$(find robstride_hardware)/calibration/joint_calibration.yaml"
    />
  </xacro:unless>

  <!-- ============================ Base and IMU ============================ -->

  <!-- Unmodelled-hardware allowance. The real robot weighs ~24.8 kg on a scale
       against this CAD export's 23.809; the difference is the wiring harness and
       other hardware absent from SolidWorks. It is carried on Base rather than as
       its own link, with the CAD figures kept separate so the export stays
       auditable. Set extra_base_mass to 0 for the pure CAD robot.
       Where the extra mass sits is unknown, so it is modelled as uniform over
       the Base collision box, centred on the CAD centre of mass: with every
       position inside the trunk equally likely, that is the expected inertia.
       Each diagonal term gains m (a^2 + b^2) / 12; the centre of mass and the
       products of inertia keep their CAD values.
       The payload_mass xacro arg (default 0) adds a carried load on top of it,
       modelled the same way: uniform over the Base box at the CAD centre of
       mass. -->
  <xacro:property name="base_mass_cad"   value="11.02" />
  <xacro:property name="extra_base_mass" value="1.0" />
  <xacro:property name="payload_mass"    value="$(arg payload_mass)" />
  <xacro:property name="added_base_mass" value="${extra_base_mass + payload_mass}" />
  <xacro:property name="base_mass"       value="${base_mass_cad + added_base_mass}" />
  <xacro:property name="base_box_x"      value="0.423" />
  <xacro:property name="base_box_y"      value="0.239" />
  <xacro:property name="base_box_z"      value="0.150" />

  <link
    name="Base">
    <inertial>
      <!-- SolidWorks export CF-AYG-1.3-00-000-URDF-7. Batteries are
           rigidly fixed inside the chassis and are lumped into this Base
           mass/inertia (no separate Battery links), so the trunk is a single
           rigid body. Whole-robot CAD mass 23.809 kg across 20 links. The mass
           and inertia diagonal below add the extra_base_mass allowance defined
           above, spread uniformly over the collision box; the
           origin and products of inertia are the CAD export's. The Base mesh
           envelope is unchanged from URDF-6, so the collision box below still
           fits. -->
      <origin
        xyz="-0.0005817 -1.9934E-05 -0.0020067"
        rpy="0 0 0" />
      <mass
        value="${base_mass}" />
      <inertia
        ixx="${round(0.035479 + added_base_mass * (base_box_y**2 + base_box_z**2) / 12, 6)}"
        ixy="-3.4801E-06"
        ixz="8.3812E-05"
        iyy="${round(0.032555 + added_base_mass * (base_box_x**2 + base_box_z**2) / 12, 6)}"
        iyz="0.00043953"
        izz="${round(0.055613 + added_base_mass * (base_box_x**2 + base_box_y**2) / 12, 6)}" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://ayg_description/meshes/Base.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.69804 0.69804 0.69804 1" />
      </material>
    </visual>
    <!-- Trunk collision: axis-aligned box wrapping the Base mesh body. Measured
         AABB is 0.423 x 0.239 x 0.180 (x -0.2125..0.2105, y +/-0.1195,
         z -0.088..0.092), but everything above z=0.062 is a single 8 mm rear tab
         at x~-0.208, so the box stops there (z -0.088..0.062, centred -0.013)
         rather than over-claiming the empty space beside the tab. -->
    <collision>
      <origin
        xyz="-0.001 0 -0.013"
        rpy="0 0 0" />
      <geometry>
        <box size="${base_box_x} ${base_box_y} ${base_box_z}" />
      </geometry>
    </collision>
  </link>

  <!-- IMU is a massless-ish reference frame only: it is rigidly fixed to Base,
       its mesh is inside the chassis (not visible) so no <visual>, and the
       Gazebo/real IMU sensor is defined on the Base link (see
       sim_ros2_control.xacro), not on this link. Mass/inertia are the
       CAD-export values (bare module, ~1.35 g); negligible vs the 24 kg total.
       URDF-7 moved the module 19 mm down (z -0.00983 -> -0.02883). -->
  <link
    name="IMU">
    <inertial>
      <origin
        xyz="-0.00099712 0.00015501 -0.00052021"
        rpy="0 0 0" />
      <mass
        value="0.0013495" />
      <inertia
        ixx="4.0133E-08"
        ixy="-6.9859E-14"
        ixz="8.9554E-12"
        iyy="5.9906E-08"
        iyz="-1.4567E-14"
        izz="9.917E-08" />
    </inertial>
  </link>

  <joint
    name="Base_2_IMU"
    type="fixed">
    <origin
      xyz="0 0 -0.02883"
      rpy="0 0 0" />
    <parent
      link="Base" />
    <child
      link="IMU" />
    <axis
      xyz="0 0 0" />
  </joint>

  <xacro:include filename="$(find ayg_description)/urdf/legs.xacro" />

  <!-- Unconditional: the head is structural chassis (0.81801 kg fixed to
       Base, reaching 0.425 m forward).
       Leaving it out would hand ayg_kindyn/Pinocchio a robot missing that mass
       and its pitch moment. The `lidar` arg inside gates only the sensor frame. -->
  <xacro:include filename="$(find ayg_description)/urdf/lidar.xacro" />
</robot>
