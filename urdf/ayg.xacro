<?xml version="1.0" encoding="utf-8"?>
<robot name="ayg" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="False" />
  <xacro:property name="sim" default="$(arg sim)" />

  <xacro:arg name="sim_backend" default="gazebo" />
  <xacro:property name="sim_backend" value="$(arg sim_backend)" />

  <xacro:arg name="gazebo_version" default="fortress" />
  <xacro:property name="gazebo_version" value="$(arg gazebo_version)" />

  <!-- Ayg 1.3 replaced the D555 depth camera with a LiDAR on a new front mount;
       the argument follows the hardware. -->
  <xacro:arg name="lidar" default="False" />
  <xacro:property name="lidar" default="$(arg lidar)" />

  <xacro:arg name="initial_configuration" default="lying_down" />
  <xacro:property name="initial_configuration" value="$(arg initial_configuration)" />
  <xacro:arg name="controller" default="default" />
  <xacro:property name="controller" default="$(arg controller)" />

  <xacro:arg name="use_csp" default="false" />

  <xacro:property name="effort_lim" value="50.0" />
  <xacro:property name="velocity_lim" value="10.0" />
  <xacro:property name="PI" value="3.1415926535897931" />

  <xacro:if value="${sim}">
    <xacro:include filename="$(find ayg_description)/urdf/ayg_sim_ros2_control.xacro" />
  </xacro:if>

  <xacro:unless value="${sim}">
    <xacro:include filename="$(find robstride_hardware)/urdf/robstride_ros2_control.xacro"/>
    <xacro:robstride_ros2_control
      lf_can_interface="can0"
      rf_can_interface="can1"
      lh_can_interface="can2"
      rh_can_interface="can3"
      actuator_type="3"
      default_kp="40.0"
      default_kd="1.0"
      use_csp="$(arg use_csp)"
      calibration_file="$(find robstride_hardware)/calibration/joint_calibration.yaml"
    />
  </xacro:unless>

  <link
    name="Base">
    <inertial>
      <!-- Ayg 1.3 SolidWorks export CF-AYG-1.3-00-000-URDF-6. Batteries are
           rigidly fixed inside the chassis and are lumped into this Base
           mass/inertia (no separate Battery links), so the trunk is a single
           rigid body. Whole-robot mass 22.948 kg across 19 links. -->
      <origin
        xyz="-0.00030633 -0.0051482 -0.0019103"
        rpy="0 0 0" />
      <mass
        value="10.732" />
      <inertia
        ixx="0.029884"
        ixy="4.1808E-07"
        ixz="0.00015159"
        iyy="0.038536"
        iyz="1.5415E-07"
        izz="0.055747" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://ayg_description/meshes/Base.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.69804 0.69804 0.69804 1" />
      </material>
    </visual>
    <!-- Trunk collision: axis-aligned box wrapping the Base mesh body. Measured
         AABB is 0.423 x 0.239 x 0.180 (x -0.2125..0.2105, y +/-0.1195,
         z -0.088..0.092), but everything above z=0.062 is a single 8 mm rear tab
         at x~-0.208, so the box stops there (z -0.088..0.062, centred -0.013)
         rather than over-claiming the empty space beside the tab. -->
    <collision>
      <origin
        xyz="-0.001 0 -0.013"
        rpy="0 0 0" />
      <geometry>
        <box size="0.423 0.239 0.150" />
      </geometry>
    </collision>
  </link>

  <!-- IMU is a massless-ish reference frame only: it is rigidly fixed to Base,
       its mesh is inside the chassis (not visible) so no <visual>, and the
       Gazebo/real IMU sensor is defined on the Base link (see
       ayg_sim_ros2_control.xacro), not on this link. Mass/inertia are the 1.3
       CAD-export values (bare module, ~1.35 g); negligible vs the 23 kg total. -->
  <link
    name="IMU">
    <inertial>
      <origin
        xyz="-0.00099712 0.00015501 -0.00052021"
        rpy="0 0 0" />
      <mass
        value="0.0013495" />
      <inertia
        ixx="4.0133E-08"
        ixy="-6.9855E-14"
        ixz="8.9554E-12"
        iyy="5.9906E-08"
        iyz="-1.4564E-14"
        izz="9.917E-08" />
    </inertial>
  </link>

  <joint
    name="Base_2_IMU"
    type="fixed">
    <origin
      xyz="0 0 -0.00983"
      rpy="0 0 0" />
    <parent
      link="Base" />
    <child
      link="IMU" />
    <axis
      xyz="0 0 0" />
  </joint>

  <xacro:include filename="$(find ayg_description)/urdf/legs.xacro" />

  <!-- Unconditional: unlike the optional D555 it replaces, the 1.3 head is
       structural chassis (0.72713 kg fixed to Base, reaching 0.425 m forward).
       Leaving it out would hand ayg_kindyn/Pinocchio a robot missing that mass
       and its pitch moment. The `lidar` arg inside gates only the sensor frame. -->
  <xacro:include filename="$(find ayg_description)/urdf/lidar.xacro" />
</robot>