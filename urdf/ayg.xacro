<?xml version="1.0" encoding="utf-8"?>
<robot name="ayg" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="sim" default="False" />
  <xacro:property name="sim" default="$(arg sim)" />

  <xacro:arg name="sim_backend" default="gazebo" />
  <xacro:property name="sim_backend" value="$(arg sim_backend)" />

  <!-- Which Ayg model to build: "1.2" or "1.3". Selects the whole per-version
       subtree (root xacro, legs, meshes, mujoco/rviz configs) - see the
       dispatch include at the bottom of this file.
       Default mirrors ayg_utils.robot_version.DEFAULT in the Ayg repo. -->
  <xacro:arg name="version" default="1.2" />

  <!-- Ayg 1.2's RealSense D555 depth camera. Consumed only by urdf/1.2/*;
       a harmless no-op when version:=1.3. -->
  <xacro:arg name="camera" default="True" />
  <xacro:property name="camera" default="$(arg camera)" />

  <!-- Ayg 1.3 replaced the D555 depth camera with a LiDAR on a new front
       mount; the argument follows the hardware. Consumed only by
       urdf/1.3/*; a harmless no-op when version:=1.2. -->
  <xacro:arg name="lidar" default="True" />
  <xacro:property name="lidar" default="$(arg lidar)" />

  <xacro:arg name="initial_configuration" default="lying_down" />
  <xacro:property name="initial_configuration" value="$(arg initial_configuration)" />
  <xacro:arg name="controller" default="default" />
  <xacro:property name="controller" default="$(arg controller)" />

  <xacro:arg name="use_csp" default="false" />

  <xacro:property name="effort_lim" value="50.0" />
  <xacro:property name="velocity_lim" value="10.0" />
  <xacro:property name="PI" value="3.1415926535897931" />

  <!-- $(arg version) substituted as TEXT, not read back through a property:
       see the dispatch include below for why. -->
  <model_version>$(arg version)</model_version>

  <xacro:if value="${sim}">
    <xacro:include filename="$(find ayg_description)/urdf/sim_ros2_control.xacro" />
  </xacro:if>

  <xacro:unless value="${sim}">
    <xacro:include filename="$(find robstride_hardware)/urdf/robstride_ros2_control.xacro"/>
    <xacro:robstride_ros2_control
      lf_can_interface="can0"
      rf_can_interface="can1"
      lh_can_interface="can2"
      rh_can_interface="can3"
      actuator_type="3"
      default_kp="40.0"
      default_kd="1.0"
      use_csp="$(arg use_csp)"
      calibration_file="$(find robstride_hardware)/calibration/joint_calibration.yaml"
    />
  </xacro:unless>

  <!-- Per-version dispatch (Base/IMU/battery/legs/camera-or-lidar): urdf/ayg1.2.xacro
       or urdf/ayg1.3.xacro, chosen by substituting $(arg version) into the
       INCLUDE FILENAME, as plain text before xacro ever runs. This must stay a
       filename substitution and NEVER become a `${version == '1.3'}` xacro:if -
       xacro coerces xacro:property values that parse as numbers, so a property
       built from $(arg version) holds the FLOAT 1.3 and an equality check
       against the string '1.3' silently evaluates false. Confirmed in the
       container; do not "simplify" this. -->
  <xacro:include filename="$(find ayg_description)/urdf/ayg$(arg version).xacro" />

</robot>
