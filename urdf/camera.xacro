<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Intel RealSense D555 (RGB-D + IMU, D450 optical module, PoE).
    Housing: 167 x 42 x 48 mm, baseline 95 mm, weight 337 g (D555 datasheet v1.1).
    Sensor-internal extrinsics are nominal D450-module values taken from
    realsense2_description/urdf/_d585.urdf.xacro (same optical module).
    realsense2_camera publishes per-unit calibrated TFs at runtime that
    supersede these nominal values.
  -->
  <xacro:property name="M_PI" value="3.1415926535897931"/>
  <xacro:property name="d555_depth_to_color_offset" value="-0.0475"/>
  <!-- Stereo IR baseline (D555 datasheet v1.1): infra1 (left) to infra2 (right). -->
  <xacro:property name="d555_stereo_baseline" value="0.095"/>
  <!--
    Mount-bracket pitch-down. The Camera.STL housing is exported from CAD
    already tilted 15 deg about the lateral axis (front-face normal measures
    15.0 deg from link +X), so the tilt must NOT be added to Base_2_Camera
    (the mesh would double-tilt). It must, however, be carried by the
    depth/color sensor frames: the optical module tilts with the housing.
  -->
  <xacro:property name="d555_mount_tilt" value="${15.0 * M_PI / 180.0}"/>

  <!--
    Massless reference frame for TF purposes only (depth/color/infra/IMU
    optical frames). An explicit epsilon-mass inertial is required because
    physics simulators (Isaac Sim, Gazebo) silently assign a 1.0 kg default
    to any link without <inertial>. Across 14 D555 reference frames that
    silently injected +14 kg of phantom mass rigid-fixed to Base — enough
    to faceplant the AYG locomotion policy in Isaac Lab. Real hardware /
    robot_state_publisher are unaffected (TF-only consumers ignore inertia).
  -->
  <xacro:macro name="massless_frame" params="name">
    <link name="${name}">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1e-6"/>
        <inertia ixx="1e-9" ixy="0" ixz="0" iyy="1e-9" iyz="0" izz="1e-9"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Physical Camera body (mesh + inertials from SolidWorks export). -->
  <link name="Camera">
    <inertial>
      <origin xyz="0.027539 -0.0054988 -1.4524E-08" rpy="0 0 0"/>
      <mass value="0.3912"/>
      <inertia ixx="0.00080723" ixy="4.4453E-06" ixz="-1.7833E-09"
               iyy="0.00082275" iyz="2.4795E-09" izz="0.00010329"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ayg_description/meshes/Camera.STL"/>
      </geometry>
      <material name="">
        <color rgba="0.69804 0.69804 0.69804 1"/>
      </material>
    </visual>
    <!--
      Collision simplified from the full Camera.STL to a primitive box sized
      to the bare D555 housing (mesh housing extent 0.0571 x 0.0443 x 0.1670 m,
      centered at 0.0286 -0.0070 0 in the Camera link frame). The thin rear
      mounting tab (-0.035 m in X) is intentionally excluded. A box is far
      cheaper for the physics broadphase/narrowphase than a 1978-triangle mesh.
    -->
    <collision>
      <origin xyz="0.0286 -0.007 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.0571 0.0443 0.167"/>
      </geometry>
    </collision>
  </link>

  <joint name="Base_2_Camera" type="fixed">
    <origin xyz="0.2475 0 0.095" rpy="1.5708 0 0"/>
    <parent link="Base"/>
    <child link="Camera"/>
    <axis xyz="0 0 0"/>
  </joint>

  <!--
    Camera frame post-Base_2_Camera is (X-fwd, Y-up, Z-right) due to the
    90 deg roll in the parent joint. Camera_depth_frame undoes that roll so
    the RealSense optical-frame convention (rpy="-pi/2 0 -pi/2" => Z-fwd)
    works as in realsense2_description, and doubles as the D450 optical-module
    reference (depth origin = left-IR origin in the module).

    The xyz=(0.0527 -0.024 0) translation places the depth origin at the
    optical-module reference inside the housing: +5.27 cm forward and -2.4 cm
    vertical (down) from the Camera link origin in robot body convention (CAD
    values for the 30 deg mount tilt). Camera link's local Y axis is Base +Z
    (up) due to the 90 deg roll above, so -0.024 along local Y = 2.4 cm down
    in body frame; local Z is Base -Y, so 0 leaves the optical module on the
    body centerline.

    The depth, color and stereo-IR (infra1/infra2) frames are modeled here; the
    accel/gyro/imu frames realsense2_description also declares are omitted since
    nothing consumes them.

    This URDF is the SINGLE TF authority for the camera subtree: ayg_camera
    launches realsense2_camera with publish_tf:=false. Letting the driver publish
    too would fork the tree — it roots its frames at Camera_link, which has no
    path to Base, while re-parenting Camera_depth_frame / Camera_color_frame away
    from this tree. cuVSLAM needs Base -> Camera_infra{1,2}_optical_frame and
    abort()s outright when the lookup fails, so a forked tree is not survivable.
    The cost is that the extrinsics here are nominal D450-module values rather
    than the driver's per-unit calibration; cuVSLAM recovers the precise stereo
    baseline from camera_info regardless.
  -->
  <!--
    The yaw component (-d555_mount_tilt, applied about the Camera link's local
    Z = the robot's lateral axis) pitches the depth frame 15 deg down with the
    housing. URDF rpy is extrinsic XYZ, so rpy=(-pi/2, 0, -tilt) composes as
    Rz(-tilt) * Rx(-pi/2): roll into the depth-frame convention first, then
    tilt in Camera-link coordinates. This matches the Isaac Lab training
    camera, which spawns at this frame's origin with a 15 deg pitch-down
    offset (rough_student_env_cfg.py depth_camera offset).
  -->
  <xacro:massless_frame name="Camera_depth_frame"/>
  <joint name="Camera_depth_joint" type="fixed">
    <origin xyz="0.0527 -0.024 0" rpy="${-M_PI/2} 0 ${-d555_mount_tilt}"/>
    <parent link="Camera"/>
    <child link="Camera_depth_frame"/>
  </joint>

  <xacro:massless_frame name="Camera_depth_optical_frame"/>
  <joint name="Camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_depth_optical_frame"/>
  </joint>

  <!-- RGB sensor (offset from the depth origin along the D450 baseline). -->
  <xacro:massless_frame name="Camera_color_frame"/>
  <joint name="Camera_color_joint" type="fixed">
    <origin xyz="0 ${d555_depth_to_color_offset} 0" rpy="0 0 0"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_color_frame"/>
  </joint>

  <xacro:massless_frame name="Camera_color_optical_frame"/>
  <joint name="Camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
    <parent link="Camera_color_frame"/>
    <child link="Camera_color_optical_frame"/>
  </joint>

  <!--
    Camera_link: the frame realsense2_camera roots its own tree at (it names
    frames <camera_name>_*, and ayg_camera passes camera_name=Camera). Declared
    here so any consumer that expects the driver's naming still resolves against
    Base. On a D4xx optical module camera_link coincides with the depth origin,
    hence the identity joint (realsense2_camera publishes camera_link ->
    camera_depth_frame as identity).
  -->
  <xacro:massless_frame name="Camera_link"/>
  <joint name="Camera_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_link"/>
  </joint>

  <!--
    Stereo IR pair — the cuVSLAM input (src/ayg_vslam). infra1 is the LEFT
    imager and IS the depth origin on a D4xx module (the driver publishes
    camera_link -> camera_infra1_frame as identity), so it sits at
    Camera_depth_frame. infra2 is the right imager, one baseline away along the
    depth frame's -Y (frame convention here is X-forward / Y-left / Z-up, so
    -Y is to the robot's right).

    Both carry the 15 deg housing tilt for free by hanging off Camera_depth_frame.
  -->
  <xacro:massless_frame name="Camera_infra1_frame"/>
  <joint name="Camera_infra1_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_infra1_frame"/>
  </joint>

  <xacro:massless_frame name="Camera_infra1_optical_frame"/>
  <joint name="Camera_infra1_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
    <parent link="Camera_infra1_frame"/>
    <child link="Camera_infra1_optical_frame"/>
  </joint>

  <xacro:massless_frame name="Camera_infra2_frame"/>
  <joint name="Camera_infra2_joint" type="fixed">
    <origin xyz="0 ${-d555_stereo_baseline} 0" rpy="0 0 0"/>
    <parent link="Camera_depth_frame"/>
    <child link="Camera_infra2_frame"/>
  </joint>

  <xacro:massless_frame name="Camera_infra2_optical_frame"/>
  <joint name="Camera_infra2_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
    <parent link="Camera_infra2_frame"/>
    <child link="Camera_infra2_optical_frame"/>
  </joint>

  <!--
    The two Gazebo sensor blocks below are simulation-only, so they are gated
    on ${sim}. With sim:=False the pure URDF (consumed by robot_state_publisher
    and kinematics/dynamics tools such as Pinocchio on real hardware) stays free
    of Gazebo-specific elements; on hardware realsense2_camera produces these
    image topics. Mirrors how ayg_sim_ros2_control.xacro is gated in ayg.xacro.
  -->
  <xacro:if value="${sim}">

  <!--
    Gazebo Ignition (Fortress) depth sensor.
    Renders along Camera_depth_frame's +X axis (forward in robot body).
    Topic and frame_id are chosen to match real-hardware realsense2_camera
    when launched with camera_name=Camera (see ayg_bringup/launch/ayg.launch.py).
    Resolution + FoV + clip range mirror D555 datasheet v1.1 depth specs.
  -->
  <gazebo reference="Camera_depth_frame">
    <sensor name="d555_depth" type="depth_camera">
      <update_rate>30</update_rate>
      <topic>camera/Camera/depth/image_rect_raw</topic>
      <gz_frame_id>Camera_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>  <!-- 87 deg -->
        <!--
          Explicit intrinsics: gz-sim Fortress otherwise populates CameraInfo
          with its default 320x240/60deg model (fx=277, cx=160, cy=120) instead
          of the configured 640x360/87deg. NOTE gz applies this only to the K
          matrix, not P; a small republisher copies K->P (ayg_gazebo
          fix_camera_info.py + depth_cloud.launch.py) so depth_image_proc
          and RViz reconstruct an aligned point cloud.
          fx=fy=(width/2)/tan(hfov/2)=337.2, cx=width/2, cy=height/2.
        -->
        <lens>
          <intrinsics>
            <fx>337.2</fx>
            <fy>337.2</fy>
            <cx>320.0</cx>
            <cy>180.0</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.26</near>  <!-- D555 Min-Z at VGA -->
          <far>9.0</far>     <!-- D555 ideal range upper bound -->
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!--
    Policy depth sensor: the exact camera the vision student was trained with
    in Isaac Lab (rough_student_env_cfg.py): 80x60 (4:3, ~71 deg vertical FoV),
    87 deg horizontal FoV, 0.26-9.0 m clip. This is NOT a resize of the
    640x360 stream above - that sensor is 16:9 (~56 deg VFoV) and physically
    cannot cover the training image's vertical extent. Sim-only; the real
    D555 shares the same 16:9 limitation, which is an open sim-to-real gap.
  -->
  <gazebo reference="Camera_depth_frame">
    <sensor name="d555_policy_depth" type="depth_camera">
      <update_rate>30</update_rate>
      <topic>camera/Camera/depth/policy_image</topic>
      <gz_frame_id>Camera_depth_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>  <!-- 87 deg -->
        <lens>
          <intrinsics>
            <fx>42.151</fx>
            <fy>42.151</fy>
            <cx>40.0</cx>
            <cy>30.0</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <image>
          <width>80</width>
          <height>60</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.26</near>
          <far>9.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!--
    RGB color sensor. Without this the /camera/Camera/color/image_raw topic
    has no producer in Gazebo (the image reads black). gz_frame_id +
    intrinsics chosen to match real-hardware realsense2_camera color stream.
  -->
  <gazebo reference="Camera_color_frame">
    <sensor name="d555_color" type="camera">
      <update_rate>30</update_rate>
      <topic>camera/Camera/color/image_raw</topic>
      <gz_frame_id>Camera_color_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.5184</horizontal_fov>  <!-- 87 deg -->
        <lens>
          <intrinsics>
            <fx>337.2</fx>
            <fy>337.2</fy>
            <cx>320.0</cx>
            <cy>180.0</cy>
            <s>0.0</s>
          </intrinsics>
        </lens>
        <image>
          <width>640</width>
          <height>360</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!--
    Stereo IR pair for Visual SLAM (src/ayg_vslam -> cuVSLAM). Two mono sensors
    one baseline apart, sharing intrinsics, so the pair is rectified by
    construction (identical rotation, pure lateral offset) — which is what
    cuVSLAM is configured for (rectified_images: true).

    Topic names match real hardware (realsense2_camera, camera_name=Camera,
    enable_infra1/2): /camera/Camera/infra{1,2}/image_rect_raw. gz leaves
    CameraInfo.P at its default, so ayg_gazebo's stereo_camera_info.launch.py
    fixes P up and writes the right camera's Tx = -fx * baseline — see
    ayg_gazebo/scripts/fix_camera_info.py.

    The real projector must be OFF for stereo VO (its dot pattern is a
    camera-fixed texture that corrupts feature tracking); in sim there is no
    projector, so nothing to disable.

    Intrinsics deliberately match the depth sensor above (fx=fy=337.2 at
    640x360, 87 deg HFoV) so sim and hardware present the same geometry.
  -->
  <xacro:macro name="infra_sensor" params="name frame optical_frame">
    <gazebo reference="${frame}">
      <sensor name="${name}" type="camera">
        <update_rate>30</update_rate>
        <topic>camera/Camera/${name}/image_rect_raw</topic>
        <gz_frame_id>${optical_frame}</gz_frame_id>
        <camera>
          <horizontal_fov>1.5184</horizontal_fov>  <!-- 87 deg -->
          <lens>
            <intrinsics>
              <fx>337.2</fx>
              <fy>337.2</fy>
              <cx>320.0</cx>
              <cy>180.0</cy>
              <s>0.0</s>
            </intrinsics>
          </lens>
          <image>
            <width>640</width>
            <height>360</height>
            <format>L8</format>  <!-- mono8: matches the real IR streams -->
          </image>
          <clip>
            <near>0.1</near>
            <far>100.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <visualize>false</visualize>
      </sensor>
    </gazebo>
  </xacro:macro>

  <!--
    Gated on its own arg, not on `camera`: two extra 640x360 renderers at 30 Hz
    is a real cost in gz, and only cuVSLAM consumes them. ayg_gazebo turns this
    on when enable_vslam:=true, so a depth-only sim run does not pay for it. The
    infra *frames* above stay unconditional: massless frames are free, and
    keeping them means the TF tree matches hardware either way.
  -->
  <xacro:if value="${stereo_ir}">
    <xacro:infra_sensor name="infra1"
                        frame="Camera_infra1_frame"
                        optical_frame="Camera_infra1_optical_frame"/>
    <xacro:infra_sensor name="infra2"
                        frame="Camera_infra2_frame"
                        optical_frame="Camera_infra2_optical_frame"/>
  </xacro:if>

  </xacro:if>

</robot>
