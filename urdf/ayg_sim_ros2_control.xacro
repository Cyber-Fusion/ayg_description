<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="ros2_control_joint" params="joint_name effort_lim initial_value">
        <joint name="${joint_name}">
            <command_interface name="effort">
                <param name="min">${-effort_lim}</param>
                <param name="max">${ effort_lim}</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">${initial_value}</param>
            </state_interface>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </xacro:macro>

    <!-- Backend-specific system name and plugin -->
    <xacro:if value="${sim_backend == 'gazebo'}">
        <xacro:property name="system_name" value="GazeboSimSystem"/>
        <xacro:property name="system_plugin" value="gz_ros2_control/GazeboSimSystem"/>
    </xacro:if>
    <xacro:if value="${sim_backend == 'mujoco'}">
        <xacro:property name="system_name" value="MujocoSystem"/>
        <xacro:property name="system_plugin" value="ayg_mujoco/MujocoSystem"/>
    </xacro:if>

    <ros2_control name="${system_name}" type="system">
        <hardware>
            <plugin>${system_plugin}</plugin>
            <xacro:if value="${sim_backend == 'mujoco'}">
                <param name="mujoco_model_path">$(find ayg_description)/mujoco/ayg.xml</param>
            </xacro:if>
        </hardware>

        <!--
            Ayg 1.3 poses. Both were re-solved for the 0.510 m leg (was 0.443 m);
            the 1.2 values no longer produce the pose they are named after. In this
            convention front and hind take the SAME joint values to reach the same
            leg pose in the Base frame (both thigh frames are Base-aligned), so the
            legs no longer need front/hind-specific numbers.

            lying_down: knee near its 1.4085 limit, hip folded so the foot sits
            under the HFE (foot 3 mm ahead of it). Base 0.1196 m, i.e. 32 mm of
            belly clearance under the trunk collision box - folded as far as the
            knee limit allows. The 1.2 values (-0.36/1.09) now leave the base at
            0.192 m, standing on part-folded legs rather than lying down.
        -->
        <xacro:if value="${initial_configuration == 'lying_down'}">
            <xacro:ros2_control_joint joint_name="LF_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="LF_HFE" effort_lim="${effort_lim}" initial_value="-0.70"/>
            <xacro:ros2_control_joint joint_name="LF_KFE" effort_lim="${effort_lim}" initial_value=" 1.40"/>
            <xacro:ros2_control_joint joint_name="RF_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="RF_HFE" effort_lim="${effort_lim}" initial_value="-0.70"/>
            <xacro:ros2_control_joint joint_name="RF_KFE" effort_lim="${effort_lim}" initial_value=" 1.40"/>
            <xacro:ros2_control_joint joint_name="LH_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="LH_HFE" effort_lim="${effort_lim}" initial_value="-0.70"/>
            <xacro:ros2_control_joint joint_name="LH_KFE" effort_lim="${effort_lim}" initial_value=" 1.40"/>
            <xacro:ros2_control_joint joint_name="RH_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="RH_HFE" effort_lim="${effort_lim}" initial_value="-0.70"/>
            <xacro:ros2_control_joint joint_name="RH_KFE" effort_lim="${effort_lim}" initial_value=" 1.40"/>
        </xacro:if>

        <!--
            standing: feet directly below their HFE origins at a 0.340 m base
            height. Solved, not hand-picked: 0.340 is 67% leg extension, the same
            fraction the 1.2 nominal (0.30 m on a 0.443 m leg) used, so the crouch
            carries over rather than the number.

            This replaces the 1.2 all-zeros pose. All-zeros is NOT a standing pose
            on 1.3: the export's zero configuration now puts the base at 0.4225 m
            (83% extension, knees near locked) instead of 0.341 m, which is below
            the 0.3 m Gazebo spawn_height and would drive the feet underground at
            spawn. The nominal stance height is ultimately a policy/cf_lab
            decision - treat 0.340 as the geometric carry-over, not a mandate.
        -->
        <xacro:if value="${initial_configuration == 'standing'}">
            <xacro:ros2_control_joint joint_name="LF_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="LF_HFE" effort_lim="${effort_lim}" initial_value="-0.2584"/>
            <xacro:ros2_control_joint joint_name="LF_KFE" effort_lim="${effort_lim}" initial_value=" 0.4485"/>
            <xacro:ros2_control_joint joint_name="RF_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="RF_HFE" effort_lim="${effort_lim}" initial_value="-0.2584"/>
            <xacro:ros2_control_joint joint_name="RF_KFE" effort_lim="${effort_lim}" initial_value=" 0.4485"/>
            <xacro:ros2_control_joint joint_name="LH_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="LH_HFE" effort_lim="${effort_lim}" initial_value="-0.2584"/>
            <xacro:ros2_control_joint joint_name="LH_KFE" effort_lim="${effort_lim}" initial_value=" 0.4485"/>
            <xacro:ros2_control_joint joint_name="RH_HAA" effort_lim="${effort_lim}" initial_value=" 0.00"/>
            <xacro:ros2_control_joint joint_name="RH_HFE" effort_lim="${effort_lim}" initial_value="-0.2584"/>
            <xacro:ros2_control_joint joint_name="RH_KFE" effort_lim="${effort_lim}" initial_value=" 0.4485"/>
        </xacro:if>

        <sensor name="imu_sensor">
            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="orientation.w"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
        </sensor>
    </ros2_control>

    <!-- Gazebo-specific plugins -->
    <xacro:if value="${sim_backend == 'gazebo'}">

        <xacro:if value="${controller == 'default'}">
            <gazebo>
                <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>$(find ayg_control)/config/gazebo/ayg_sw_controllers.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>

        <xacro:if value="${controller == 'ddb'}">
            <gazebo>
                <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
                    <parameters>$(find robot_control_ddb)/config/gazebo/ayg_control.yaml</parameters>
                </plugin>
            </gazebo>
        </xacro:if>

        <xacro:if value="${gazebo_version == 'fortress'}">
            <gazebo>
                <plugin filename="ignition-gazebo-odometry-publisher-system"
                        name="ignition::gazebo::systems::OdometryPublisher">
                    <odom_frame>Base</odom_frame>
                    <robot_base_frame>Base</robot_base_frame>
                    <odom_publish_frequency>500</odom_publish_frequency>
                    <dimensions>3</dimensions>
                </plugin>
            </gazebo>

            <gazebo>
                <plugin filename="ignition-gazebo-imu-system"
                        name="ignition::gazebo::systems::Imu"/>
            </gazebo>
        </xacro:if>

        <xacro:unless value="${gazebo_version == 'fortress'}">
            <gazebo>
                <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
                    <odom_frame>Base</odom_frame>
                    <robot_base_frame>Base</robot_base_frame>
                    <odom_publish_frequency>500</odom_publish_frequency>
                    <dimensions>3</dimensions>
                </plugin>
            </gazebo>

            <gazebo>
                <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
                </plugin>
            </gazebo>
        </xacro:unless>

        <gazebo reference="Base">
            <sensor name="imu_sensor" type="imu">
                <always_on>true</always_on>
                <update_rate>400</update_rate>
                <visualize>true</visualize>
                <topic>imu</topic>

                <imu>
                    <angular_velocity>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0</stddev>
                                <bias_mean>0.00000</bias_mean>
                                <bias_stddev>0.000000</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>-0.0</mean>
                                <stddev>0</stddev>
                                <bias_mean>0.00000</bias_mean>
                                <bias_stddev>0.000000</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0</stddev>
                                <bias_mean>0.00000</bias_mean>
                                <bias_stddev>0.000000</bias_stddev>
                            </noise>
                        </z>
                    </angular_velocity>
                    <linear_acceleration>
                        <x>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.00</bias_stddev>
                            </noise>
                        </x>
                        <y>
                            <noise type="gaussian">
                                <mean>-0.0</mean>
                                <stddev>0</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.00</bias_stddev>
                            </noise>
                        </y>
                        <z>
                            <noise type="gaussian">
                                <mean>0.0</mean>
                                <stddev>0</stddev>
                                <bias_mean>0.0</bias_mean>
                                <bias_stddev>0.00</bias_stddev>
                            </noise>
                        </z>
                    </linear_acceleration>
                </imu>
            </sensor>
        </gazebo>

    </xacro:if>

</robot>
