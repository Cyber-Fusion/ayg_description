<?xml version="1.0" encoding="utf-8"?>
<!-- Ayg 1.3 per-version root: Base, IMU. No battery links - the 1.3 chassis
     lumps the batteries into Base (see the mass note below). Included by
     urdf/ayg.xacro via filename substitution on $(arg version); do not run
     this file directly (no `sim`/`camera`/etc. args are declared here, the
     dispatcher owns those). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link
    name="Base">
    <inertial>
      <!-- Ayg 1.3 SolidWorks export CF-AYG-1.3-00-000-URDF-7. Batteries are
           rigidly fixed inside the chassis and are lumped into this Base
           mass/inertia (no separate Battery links), so the trunk is a single
           rigid body. Whole-robot mass 23.809 kg across 19 links. The Base
           mesh envelope is unchanged from URDF-6, so the collision box below
           still fits. -->
      <origin
        xyz="-0.0005817 -1.9934E-05 -0.0020067"
        rpy="0 0 0" />
      <mass
        value="11.02" />
      <inertia
        ixx="0.035479"
        ixy="-3.4801E-06"
        ixz="8.3812E-05"
        iyy="0.032555"
        iyz="0.00043953"
        izz="0.055613" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://ayg_description/meshes/1.3/Base.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="0.69804 0.69804 0.69804 1" />
      </material>
    </visual>
    <!-- Trunk collision: axis-aligned box wrapping the Base mesh body. Measured
         AABB is 0.423 x 0.239 x 0.180 (x -0.2125..0.2105, y +/-0.1195,
         z -0.088..0.092), but everything above z=0.062 is a single 8 mm rear tab
         at x~-0.208, so the box stops there (z -0.088..0.062, centred -0.013)
         rather than over-claiming the empty space beside the tab. -->
    <collision>
      <origin
        xyz="-0.001 0 -0.013"
        rpy="0 0 0" />
      <geometry>
        <box size="0.423 0.239 0.150" />
      </geometry>
    </collision>
  </link>

  <!-- IMU is a massless-ish reference frame only: it is rigidly fixed to Base,
       its mesh is inside the chassis (not visible) so no <visual>, and the
       Gazebo/real IMU sensor is defined on the Base link (see
       ayg_sim_ros2_control.xacro), not on this link. Mass/inertia are the 1.3
       CAD-export values (bare module, ~1.35 g); negligible vs the 24 kg total.
       URDF-7 moved the module 19 mm down (z -0.00983 -> -0.02883). -->
  <link
    name="IMU">
    <inertial>
      <origin
        xyz="-0.00099712 0.00015501 -0.00052021"
        rpy="0 0 0" />
      <mass
        value="0.0013495" />
      <inertia
        ixx="4.0133E-08"
        ixy="-6.9859E-14"
        ixz="8.9554E-12"
        iyy="5.9906E-08"
        iyz="-1.4567E-14"
        izz="9.917E-08" />
    </inertial>
  </link>

  <joint
    name="Base_2_IMU"
    type="fixed">
    <origin
      xyz="0 0 -0.02883"
      rpy="0 0 0" />
    <parent
      link="Base" />
    <child
      link="IMU" />
    <axis
      xyz="0 0 0" />
  </joint>

  <xacro:include filename="$(find ayg_description)/urdf/1.3/legs.xacro" />

  <!-- Unconditional: unlike the optional D555 it replaces, the 1.3 head is
       structural chassis (0.81801 kg fixed to Base, reaching 0.425 m forward).
       Leaving it out would hand ayg_kindyn/Pinocchio a robot missing that mass
       and its pitch moment. The `lidar` arg inside gates only the sensor frame. -->
  <xacro:include filename="$(find ayg_description)/urdf/1.3/lidar.xacro" />
</robot>