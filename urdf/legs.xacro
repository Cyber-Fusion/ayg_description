<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Legs, Ayg 1.3 (SolidWorks export CF-AYG-1.3-00-000-URDF-6).

    One macro instantiated four times. `sx` = +1 front / -1 hind, `sy` = +1 left /
    -1 right; every joint origin and mirrored inertia term is written as an export
    value times those signs, so the file reads as a direct transcription of the
    export and can be re-checked against a future one line by line.

    Frames are the export's own placement, unchanged. Axes are normalized to the
    deployed convention: HAA about +x, HFE/KFE about -y (the export uses +y for
    HFE/KFE, so those two joints carry a negated axis and correspondingly
    negated-and-swapped limits). Because the HFE/KFE axes are parallel to y, the
    export's frame origins sit at an arbitrary point along the rotation axis -
    sliding them in y is kinematically null, which is why the export's y offsets
    differ from earlier revisions while the foot positions are identical.

    Segment lengths: thigh |(-0.15715, -0.20082)| = shank |(0.170476, -0.189639)|
    = 0.255 m exactly, so the leg extends 0.510 m hip-to-foot (was 0.443 m).
  -->

  <xacro:macro name="ayg_leg" params="side FH sx sy">

    <!-- ============================== Hip ============================== -->
    <!-- Four distinct hip meshes: front/hind are x-mirrored and left/right are
         Rx(pi) of each other, and the export tessellates each separately, so no
         single pair can be reused by rotating a joint frame. -->
    <link name="${side}${FH}_Hip">
      <inertial>
        <origin xyz="${0.059856*sx} ${0.0023868*sy} ${1.6688E-05*sx*sy}" rpy="0 0 0" />
        <mass value="0.98111" />
        <inertia ixx="0.00070791" ixy="${1.6598E-06*sx*sy}" ixz="${9.3501E-07*sy}"
                 iyy="0.0012845"  iyz="${-2.4177E-07*sx}"   izz="0.00087996" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/${side}${FH}_Hip.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <!-- Rounded hip housing: one cylinder about y. Mesh AABB is
           0.116 (x) x 0.058 (y) x 0.103 (z); r=0.053 wraps z exactly and leaves
           the last ~5 mm of each x end uncovered, which is where the HAA flange
           and the HFE interface sit - both shielded by the neighbouring link. -->
      <collision>
        <origin xyz="${0.056*sx} ${-0.004*sy} 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder radius="0.053" length="0.058" />
        </geometry>
      </collision>
    </link>

    <joint name="${side}${FH}_HAA" type="revolute">
      <origin xyz="${0.203*sx} ${0.054*sy} 0" rpy="0 0 0" />
      <parent link="Base" />
      <child link="${side}${FH}_Hip" />
      <axis xyz="1 0 0" />
      <!-- Export HAA limits carry over verbatim (axis unchanged). The outward
           travel differs front vs hind: 0.43633 front, 0.8203 hind. -->
      <xacro:if value="${side == 'L'}">
        <limit lower="-0.5236" upper="${0.43633 if FH == 'F' else 0.8203}"
               effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:if>
      <xacro:unless value="${side == 'L'}">
        <limit lower="${-0.43633 if FH == 'F' else -0.8203}" upper="0.5236"
               effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:unless>
    </joint>

    <!-- ============================= Thigh ============================= -->
    <!-- Front and hind share one mesh per side (LF_Thigh and LH_Thigh are
         geometrically identical in the export, likewise RF/RH), so only L_/R_
         are shipped.
         The thigh now carries the HFE motor barrel: the hip's y extent dropped
         from 0.148 to 0.058 between revisions and the barrel moved to this link. -->
    <link name="${side}${FH}_Thigh">
      <inertial>
        <xacro:if value="${side == 'L'}">
          <origin xyz="-0.028374 -0.02602 -0.029622" rpy="0 0 0" />
          <mass value="1.5051" />
          <inertia ixx="0.0043448" ixy="0.00034914" ixz="-0.0029698"
                   iyy="0.0075708" iyz="0.00034106" izz="0.0039222" />
        </xacro:if>
        <xacro:unless value="${side == 'L'}">
          <origin xyz="-0.02838 0.025988 -0.029631" rpy="0 0 0" />
          <mass value="1.5052" />
          <inertia ixx="0.0043476" ixy="-0.00034935" ixz="-0.0029719"
                   iyy="0.0075751" iyz="-0.00034134" izz="0.0039239" />
        </xacro:unless>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/${side}_Thigh.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <!-- HFE motor barrel: cylinder coaxial with the HFE axis, so it is
           invariant under hip-flexion and can never self-collide with the hip. -->
      <collision>
        <origin xyz="0 ${-0.03205*sy} 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder radius="0.055" length="0.088" />
        </geometry>
      </collision>
      <!-- Slim leg member: box pitched about y onto the HFE->KFE line
           (atan2(-0.15715, -0.20082) = -2.4776 rad), shortened at the knee end
           where the shank's coaxial knee cylinder takes over. -->
      <collision>
        <origin xyz="-0.1121 ${-0.0035*sy} -0.1091" rpy="0 -2.4776 0" />
        <geometry>
          <box size="0.052 0.016 0.170" />
        </geometry>
      </collision>
    </link>

    <joint name="${side}${FH}_HFE" type="revolute">
      <origin xyz="${0.063*sx} ${0.0996*sy} 0" rpy="0 0 0" />
      <parent link="${side}${FH}_Hip" />
      <child link="${side}${FH}_Thigh" />
      <axis xyz="0 -1 0" />
      <!-- Export limits negated and swapped for the -y axis:
           front  (-3.3693, 2.0412) -> (-2.0412, 3.3693)
           hind   (-2.5839, 2.8266) -> (-2.8266, 2.5839) -->
      <xacro:if value="${FH == 'F'}">
        <limit lower="-2.0412" upper="3.3693" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <limit lower="-2.8266" upper="2.5839" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:unless>
    </joint>

    <!-- ============================= Shank ============================= -->
    <!-- All four shank meshes are geometrically identical in the export, so one
         Shank.STL serves every leg. The part is unchanged from the previous
         revision; only its frame slid 15.6 mm along y (the foot now sits at y=0
         in this frame). -->
    <link name="${side}${FH}_Shank">
      <inertial>
        <origin xyz="0.081442 -1.3138E-05 -0.079562" rpy="0 0 0" />
        <mass value="0.34563" />
        <inertia ixx="0.0016882" ixy="-5.8149E-12" ixz="0.0015751"
                 iyy="0.0032906" iyz="-3.2788E-12" izz="0.0016244" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/Shank.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <!-- Slim leg member: box pitched onto the KFE->foot line
           (atan2(0.170476, -0.189639) = +2.4094 rad). Widened to 0.040 in the
           box's x from the 0.020 used for the previous revision: the strut is
           curved, and 0.020 left the outer ~25 mm of its sweep uncovered. -->
      <collision>
        <origin xyz="0.0897 0 -0.0938" rpy="0 2.4094 0" />
        <geometry>
          <box size="0.040 0.017 0.180" />
        </geometry>
      </collision>
      <!-- Knee filler: cylinder coaxial with the KFE axis, so it is invariant
           under knee bend and bridges the thigh/shank gap for external contacts
           without ever self-colliding with either. Length follows the new knee
           width (0.018 measured) rather than the old 0.031. -->
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder radius="0.030" length="0.019" />
        </geometry>
      </collision>
    </link>

    <joint name="${side}${FH}_KFE" type="revolute">
      <origin xyz="-0.15715 ${-0.0035*sy} -0.20082" rpy="0 0 0" />
      <parent link="${side}${FH}_Thigh" />
      <child link="${side}${FH}_Shank" />
      <axis xyz="0 -1 0" />
      <!-- Export (-1.4085, 0.56374) negated and swapped for the -y axis. -->
      <limit lower="-0.56374" upper="1.4085" effort="${effort_lim}" velocity="${velocity_lim}" />
    </joint>

    <!-- ============================== Foot ============================= -->
    <!-- Modelled as primitives rather than the export's Foot mesh: the export's
         own inertia is exactly that of a solid cylinder r=0.032, L=0.031 about y
         (iyy = m r^2 / 2 = 2.048E-05, ixx = izz = m r^2 / 4 + m L^2 / 12 =
         1.3443E-05), so the primitive is the mass model, not an approximation. -->
    <link name="${side}${FH}_Foot">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.04" />
        <inertia ixx="1.3443E-05" ixy="0" ixz="0"
                 iyy="2.048E-05"  iyz="0" izz="1.3443E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry>
          <cylinder radius="0.032" length="0.031" />
        </geometry>
        <material name="">
          <color rgba="0.29804 0.29804 0.29804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.032" />
        </geometry>
      </collision>
    </link>

    <joint name="${side}${FH}_Shank_2_Foot" type="fixed">
      <origin xyz="0.170476 0 -0.189639" rpy="0 0 0" />
      <parent link="${side}${FH}_Shank" />
      <child link="${side}${FH}_Foot" />
      <axis xyz="0 0 0" />
    </joint>

  </xacro:macro>

  <xacro:ayg_leg side="L" FH="F" sx="1"  sy="1"  />
  <xacro:ayg_leg side="R" FH="F" sx="1"  sy="-1" />
  <xacro:ayg_leg side="L" FH="H" sx="-1" sy="1"  />
  <xacro:ayg_leg side="R" FH="H" sx="-1" sy="-1" />
</robot>
