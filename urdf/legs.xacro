<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Parameterized legs (Ayg 1.3). Two macros, L_Leg / R_Leg, each instantiated
    for front (FH="F") and hind (FH="H"). Hind legs carry a pi yaw on the HAA and
    HFE joint origins so that identical joint values mirror the front leg (the net
    rotation on the thigh/shank frames is 2*pi = identity; the hip frame keeps one
    pi flip). Joint axes are normalized (HAA about +x world, HFE/KFE about -y
    world) to match the deployed convention (robstride_ros2_control / calibration /
    policy). Front and hind reuse the same L_/R_ segment meshes.
    Inertials/limits are the SolidWorks 1.3 export values mapped into this
    convention; collision primitives approximate the members (refined in sim).
  -->

  <xacro:macro name="L_Leg" params="FH">
    <link name="L${FH}_Hip">
      <inertial>
        <xacro:if value="${FH == 'F'}">
          <origin xyz="0.062976 -0.0014435 9.395E-06" rpy="0 0 0" />
          <mass value="1.017" />
          <inertia ixx="0.00088413" ixy="1.6599E-05" ixz="5.521E-07"
                   iyy="0.0014074" iyz="-1.7604E-07" izz="0.00099675" />
        </xacro:if>
        <xacro:unless value="${FH == 'F'}">
          <origin xyz="0.062976 0.0014435 -9.395E-06" rpy="0 0 0" />
          <mass value="1.017" />
          <inertia ixx="0.00088413" ixy="-1.6599E-05" ixz="-5.521E-07"
                   iyy="0.0014074" iyz="-1.7604E-07" izz="0.00099675" />
        </xacro:unless>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <xacro:if value="${FH == 'F'}">
            <mesh filename="package://ayg_description/meshes/L_Hip.STL" />
          </xacro:if>
          <xacro:unless value="${FH == 'F'}">
            <mesh filename="package://ayg_description/meshes/R_Hip.STL" />
          </xacro:unless>
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.055 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.11 0.07 0.11" />
        </geometry>
      </collision>
    </link>
    <joint name="L${FH}_HAA" type="revolute">
      <xacro:if value="${FH == 'F'}">
        <origin xyz="0.2105 0.054 0" rpy="0 0 0" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <origin xyz="-0.2105 0.054 0" rpy="0 0 ${PI}" />
      </xacro:unless>
      <parent link="Base" />
      <child link="L${FH}_Hip" />
      <xacro:if value="${FH == 'F'}">
        <axis xyz="1 0 0" />
        <limit lower="-0.5236" upper="0.43633" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <axis xyz="-1 0 0" />
        <limit lower="-0.5236" upper="0.8203" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:unless>
    </joint>
    <link name="L${FH}_Thigh">
      <inertial>
        <origin xyz="-0.023305 0.049402 -0.024328" rpy="0 0 0" />
        <mass value="1.505" />
        <inertia ixx="0.0030493" ixy="-3.2033E-06" ixz="-0.0016346"
                 iyy="0.0052191" iyz="-1.6215E-06" izz="0.0026578" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/L_Thigh.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-0.0786 0.0285 -0.1004" rpy="0 2.4474 2.7935" />
        <geometry>
          <box size="0.06 0.06 0.24" />
        </geometry>
      </collision>
    </link>
    <joint name="L${FH}_HFE" type="revolute">
      <xacro:if value="${FH == 'F'}">
        <origin xyz="0.065 0.0235 0" rpy="0 0 0" />
        <limit lower="-1.2625" upper="3.0761" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <origin xyz="0.065 -0.0235 0" rpy="0 0 ${PI}" />
        <limit lower="-2.2907" upper="2.0479" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:unless>
      <parent link="L${FH}_Hip" />
      <child link="L${FH}_Thigh" />
      <axis xyz="0 -1 0" />
    </joint>
    <link name="L${FH}_Shank">
      <inertial>
        <origin xyz="0.081442 0.015569 -0.079562" rpy="0 0 0" />
        <mass value="0.34563" />
        <inertia ixx="0.0016882" ixy="-5.8149E-12" ixz="0.0015751"
                 iyy="0.0032906" iyz="-3.2788E-12" izz="0.0016244" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/L_Shank.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.0852 0.0078 -0.0948" rpy="0 2.4073 0.0911" />
        <geometry>
          <box size="0.05 0.05 0.24" />
        </geometry>
      </collision>
    </link>
    <joint name="L${FH}_KFE" type="revolute">
      <origin xyz="-0.15715 0.057018 -0.20082" rpy="0 0 0" />
      <parent link="L${FH}_Thigh" />
      <child link="L${FH}_Shank" />
      <axis xyz="0 -1 0" />
      <limit lower="-0.56374" upper="1.4015" effort="${effort_lim}" velocity="${velocity_lim}" />
    </joint>
    <link name="L${FH}_Foot">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.04" />
        <inertia ixx="1.3443E-05" ixy="0" ixz="0"
                 iyy="2.048E-05" iyz="0" izz="1.3443E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/Foot.STL" />
        </geometry>
        <material name="">
          <color rgba="0.29804 0.29804 0.29804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.032" />
        </geometry>
      </collision>
    </link>
    <joint name="L${FH}_Shank_2_Foot" type="fixed">
      <origin xyz="0.17048 0.015582 -0.18964" rpy="0 0 0" />
      <parent link="L${FH}_Shank" />
      <child link="L${FH}_Foot" />
      <axis xyz="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:macro name="R_Leg" params="FH">
    <link name="R${FH}_Hip">
      <inertial>
        <xacro:if value="${FH == 'F'}">
          <origin xyz="0.062976 0.0014435 -9.395E-06" rpy="0 0 0" />
          <mass value="1.017" />
          <inertia ixx="0.00088413" ixy="-1.6599E-05" ixz="-5.521E-07"
                   iyy="0.0014074" iyz="-1.7604E-07" izz="0.00099675" />
        </xacro:if>
        <xacro:unless value="${FH == 'F'}">
          <origin xyz="0.062976 -0.0014435 9.395E-06" rpy="0 0 0" />
          <mass value="1.017" />
          <inertia ixx="0.00088413" ixy="1.6599E-05" ixz="5.521E-07"
                   iyy="0.0014074" iyz="-1.7604E-07" izz="0.00099675" />
        </xacro:unless>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <xacro:if value="${FH == 'F'}">
            <mesh filename="package://ayg_description/meshes/R_Hip.STL" />
          </xacro:if>
          <xacro:unless value="${FH == 'F'}">
            <mesh filename="package://ayg_description/meshes/L_Hip.STL" />
          </xacro:unless>
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.055 0 0" rpy="0 0 0" />
        <geometry>
          <box size="0.11 0.07 0.11" />
        </geometry>
      </collision>
    </link>
    <joint name="R${FH}_HAA" type="revolute">
      <xacro:if value="${FH == 'F'}">
        <origin xyz="0.2105 -0.054 0" rpy="0 0 0" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <origin xyz="-0.2105 -0.054 0" rpy="0 0 ${PI}" />
      </xacro:unless>
      <parent link="Base" />
      <child link="R${FH}_Hip" />
      <xacro:if value="${FH == 'F'}">
        <axis xyz="1 0 0" />
        <limit lower="-0.43633" upper="0.5236" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <axis xyz="-1 0 0" />
        <limit lower="-0.8203" upper="0.5236" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:unless>
    </joint>
    <link name="R${FH}_Thigh">
      <inertial>
        <origin xyz="-0.02331 -0.049428 -0.024336" rpy="0 0 0" />
        <mass value="1.5051" />
        <inertia ixx="0.0030504" ixy="3.2136E-06" ixz="-0.0016352"
                 iyy="0.0052207" iyz="1.6374E-06" izz="0.0026583" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/R_Thigh.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="-0.0786 -0.0285 -0.1004" rpy="0 2.4474 -2.7935" />
        <geometry>
          <box size="0.06 0.06 0.24" />
        </geometry>
      </collision>
    </link>
    <joint name="R${FH}_HFE" type="revolute">
      <xacro:if value="${FH == 'F'}">
        <origin xyz="0.065 -0.0235 0" rpy="0 0 0" />
        <limit lower="-1.2625" upper="3.0761" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:if>
      <xacro:unless value="${FH == 'F'}">
        <origin xyz="0.065 0.0235 0" rpy="0 0 ${PI}" />
        <limit lower="-2.2907" upper="2.0479" effort="${effort_lim}" velocity="${velocity_lim}" />
      </xacro:unless>
      <parent link="R${FH}_Hip" />
      <child link="R${FH}_Thigh" />
      <axis xyz="0 -1 0" />
    </joint>
    <link name="R${FH}_Shank">
      <inertial>
        <origin xyz="0.081442 -0.015577 -0.079562" rpy="0 0 0" />
        <mass value="0.34563" />
        <inertia ixx="0.0016882" ixy="-5.8149E-12" ixz="0.0015751"
                 iyy="0.0032906" iyz="-3.2788E-12" izz="0.0016244" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/R_Shank.STL" />
        </geometry>
        <material name="">
          <color rgba="0.69804 0.69804 0.69804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0.0852 -0.0078 -0.0948" rpy="0 2.4073 -0.0911" />
        <geometry>
          <box size="0.05 0.05 0.24" />
        </geometry>
      </collision>
    </link>
    <joint name="R${FH}_KFE" type="revolute">
      <origin xyz="-0.15715 -0.057037 -0.20082" rpy="0 0 0" />
      <parent link="R${FH}_Thigh" />
      <child link="R${FH}_Shank" />
      <axis xyz="0 -1 0" />
      <limit lower="-0.56374" upper="1.4015" effort="${effort_lim}" velocity="${velocity_lim}" />
    </joint>
    <link name="R${FH}_Foot">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.04" />
        <inertia ixx="1.3443E-05" ixy="0" ixz="0"
                 iyy="2.048E-05" iyz="0" izz="1.3443E-05" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://ayg_description/meshes/Foot.STL" />
        </geometry>
        <material name="">
          <color rgba="0.29804 0.29804 0.29804 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.032" />
        </geometry>
      </collision>
    </link>
    <joint name="R${FH}_Shank_2_Foot" type="fixed">
      <origin xyz="0.170476 -0.0155635 -0.189639" rpy="0 0 0" />
      <parent link="R${FH}_Shank" />
      <child link="R${FH}_Foot" />
      <axis xyz="0 0 0" />
    </joint>
  </xacro:macro>

  <xacro:L_Leg FH="F" />
  <xacro:R_Leg FH="F" />
  <xacro:L_Leg FH="H" />
  <xacro:R_Leg FH="H" />
</robot>
